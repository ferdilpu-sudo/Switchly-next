<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.NETCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Switchly.Application\Switchly.Application.csproj" />
  </ItemGroup>

  <!-- Flow CEF locales (*.pak) to referencing host apps without leaking CefSharp packages. -->
  <ItemGroup>
    <Content Include="@(CefRuntimeWin64Locales)"
             Link="locales\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

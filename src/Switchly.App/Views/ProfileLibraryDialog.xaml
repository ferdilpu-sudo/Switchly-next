<Window x:Class="Switchly.App.Views.ProfileLibraryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Switchly.App.Themes"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Perpustakaan Profil — Switchly"
        Height="540" Width="700"
        MinHeight="430" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Tutup" IsCancel="True" Padding="16,7"/>
        </StackPanel>

        <TabControl x:Name="LibraryTabs">
            <!-- UI-005: Bookmarks -->
            <TabItem Header="Bookmark">
                <DockPanel Margin="14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Buka"
                                Click="OnOpenBookmarkClick" Padding="14,6" Margin="6,0,0,0"/>
                        <Button x:Name="DeleteBookmarkButton" DockPanel.Dock="Right" Style="{StaticResource DangerOutlineButtonStyle}" Content="Hapus"
                                Click="OnDeleteBookmarkClick" Padding="12,6" Margin="8,0,0,0"/>
                        <TextBox x:Name="BookmarkSearchBox" Style="{StaticResource PillTextBoxStyle}"
                                 themes:TextBoxAssist.PlaceholderText="Cari bookmark berdasarkan judul atau URL..."
                                 AutomationProperties.Name="Cari bookmark"
                                 TextChanged="OnBookmarkSearchChanged"
                                 ToolTip="Cari bookmark berdasarkan judul atau URL"/>
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="BookmarksList" Background="{DynamicResource BgAppBrush}"
                                 MouseDoubleClick="OnBookmarkDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Buka Bookmark" Click="OnOpenBookmarkClick"/>
                                    <MenuItem Header="Salin URL" Click="OnCopyBookmarkUrlClick"/>
                                    <Separator/>
                                    <MenuItem Header="Hapus Bookmark" Click="OnDeleteBookmarkClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" LineHeight="18"/>
                                        <TextBlock Text="{Binding Url}" FontSize="12" LineHeight="17" Padding="0,0,0,1"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,0" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=BookmarksList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconStar}"
                                      Stroke="{DynamicResource AccentBrush}" Width="20" Height="20"/>
                            </Border>
                            <TextBlock Text="Belum ada bookmark di profil ini" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Gunakan menu ⋯ → Simpan Bookmark pada halaman yang sering dibuka."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="360"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- UI-006: History -->
            <TabItem Header="Riwayat">
                <DockPanel Margin="14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Buka"
                                Click="OnOpenHistoryClick" Padding="14,6" Margin="6,0,0,0"/>
                        <Button x:Name="ClearHistoryButton" DockPanel.Dock="Right" Style="{StaticResource DangerOutlineButtonStyle}" Content="Hapus Semua"
                                Click="OnClearHistoryClick" Padding="12,6" Margin="8,0,0,0"/>
                        <TextBox x:Name="HistorySearchBox" Style="{StaticResource PillTextBoxStyle}"
                                 themes:TextBoxAssist.PlaceholderText="Cari riwayat kunjungan profil ini..."
                                 AutomationProperties.Name="Cari riwayat"
                                 TextChanged="OnHistorySearchChanged"
                                 ToolTip="Cari riwayat kunjungan profil ini"/>
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="HistoryList" Background="{DynamicResource BgAppBrush}"
                                 MouseDoubleClick="OnHistoryDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Buka Halaman" Click="OnOpenHistoryClick"/>
                                    <MenuItem Header="Salin URL" Click="OnCopyHistoryUrlClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" LineHeight="18"/>
                                        <TextBlock Text="{Binding Url}" FontSize="12" LineHeight="17" Padding="0,0,0,1"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,0" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=HistoryList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconHistory}"
                                      Stroke="{DynamicResource AccentBrush}" Width="20" Height="20"/>
                            </Border>
                            <TextBlock Text="Belum ada riwayat kunjungan" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Halaman web yang Anda kunjungi di profil ini akan tercatat secara terisolasi di sini."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="360"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- UI-007: Downloads -->
            <TabItem Header="Unduhan">
                <DockPanel Margin="14">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Buka File"
                                Click="OnOpenDownloadFileClick" Padding="14,6" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Tampilkan di Folder" Click="OnOpenDownloadFolderClick" Padding="12,6"/>
                        <TextBlock Text="Daftar unduhan milik profil ini:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="DownloadsList" Background="{DynamicResource BgAppBrush}"
                                 MouseDoubleClick="OnDownloadDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Buka File" Click="OnOpenDownloadFileClick"/>
                                    <MenuItem Header="Tampilkan di Folder" Click="OnOpenDownloadFolderClick"/>
                                    <Separator/>
                                    <MenuItem Header="Salin Path File" Click="OnCopyDownloadPathClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="4,4">
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding StatusColor}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" LineHeight="18"/>
                                            <TextBlock Text="{Binding StatusSummary}" FontSize="12" LineHeight="17"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding TargetPath}" FontSize="12" LineHeight="16" Padding="0,0,0,1"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,0" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=DownloadsList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconDownload}"
                                      Stroke="{DynamicResource AccentBrush}" Width="20" Height="20"/>
                            </Border>
                            <TextBlock Text="Belum ada riwayat unduhan" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="File yang diunduh pada sesi profil ini akan muncul di sini beserta lokasi simpannya."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="360"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

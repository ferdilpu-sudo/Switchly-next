<Window x:Class="Switchly.App.Views.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="840" Width="1280"
        MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <DockPanel>
        <!-- Tab Strip -->
        <Border DockPanel.Dock="Top" Background="#E5E7EB" Padding="6,6,6,0">
            <DockPanel>
                <Border x:Name="ProfileBadge" DockPanel.Dock="Left" CornerRadius="4" Padding="8,4" Margin="0,0,8,4" Background="#1B6EF3">
                    <TextBlock x:Name="ProfileNameText" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <Button DockPanel.Dock="Right" Content="+ Tab" Click="OnNewTabClick" Padding="10,4" Margin="6,0,0,4"
                        ToolTip="Tab baru (Ctrl+T)"/>
                <ListBox x:Name="TabStrip" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnTabSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0"
                                    Padding="8,4" Margin="0,0,4,0" MaxWidth="220">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="×" Click="OnCloseTabClick" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="4,0" Margin="6,0,0,0"
                                            ToolTip="Tutup tab (Ctrl+W)"/>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Navigation Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="0,1,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="BackButton" Content="←" Click="OnBackClick" Padding="8,4" Margin="0,0,4,0" ToolTip="Kembali"/>
                    <Button x:Name="ForwardButton" Content="→" Click="OnForwardClick" Padding="8,4" Margin="0,0,4,0" ToolTip="Maju"/>
                    <Button x:Name="ReloadButton" Content="↻" Click="OnReloadClick" Padding="8,4" ToolTip="Muat ulang"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Jendela Baru" Click="OnNewWindowClick" Padding="10,4" Margin="6,0,0,0"
                        ToolTip="Buka jendela tambahan dengan sesi profil yang sama"/>
                <Button DockPanel.Dock="Right" Content="Unduhan" Click="OnShowDownloadsClick" Padding="10,4" Margin="6,0,0,0"
                        ToolTip="Lihat daftar unduhan profil ini"/>
                <Button DockPanel.Dock="Right" Content="Riwayat" Click="OnShowHistoryClick" Padding="10,4" Margin="6,0,0,0"
                        ToolTip="Lihat riwayat profil ini"/>
                <Button DockPanel.Dock="Right" Content="★ Bookmark" Click="OnBookmarkCurrentClick" Padding="10,4" Margin="6,0,0,0"
                        ToolTip="Simpan halaman ini ke bookmark profil"/>
                <Button DockPanel.Dock="Right" Content="Buka" Click="OnNavigateClick" Padding="14,4" Margin="6,0,0,0"/>
                <TextBox x:Name="AddressBox" VerticalContentAlignment="Center" Padding="6,4" KeyDown="OnAddressBoxKeyDown"
                         ToolTip="Address bar (Ctrl+L)"/>
            </DockPanel>
        </Border>

        <!-- Active Tab Browser Surface -->
        <ContentControl x:Name="BrowserContainer"/>
    </DockPanel>
</Window>

<Window x:Class="Switchly.App.Views.UnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buka Kunci — Switchly Next"
        Height="250" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Switchly Next Terkunci" FontSize="17" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="Masukkan kata sandi utama lokal untuk membuka workspace." Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <PasswordBox x:Name="MasterPasswordBox" Padding="8,6" Margin="0,0,0,8"/>
        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="12" Visibility="Collapsed" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Buka Kunci" Click="OnUnlockClick" IsDefault="True"
                    Background="#1B6EF3" Foreground="White" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Keluar" IsCancel="True" Padding="14,6"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="Switchly.App.Views.UnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Buka Kunci — Switchly"
        Width="440" MaxHeight="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="22">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="32" Height="32"
                   RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Switchly Terkunci" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="Masukkan kata sandi utama lokal untuk membuka workspace."
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <PasswordBox x:Name="MasterPasswordBox" Margin="0,0,0,8"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerSoftTextBrush}"
                   FontSize="12" Visibility="Collapsed" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Keluar" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Buka Kunci"
                    Click="OnUnlockClick" IsDefault="True" Padding="18,7"/>
        </StackPanel>
    </StackPanel>
</Window>

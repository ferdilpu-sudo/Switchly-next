<Window x:Class="Switchly.App.Views.ProfileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Switchly.App.Themes"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Profil Browser — Switchly"
        Width="490" MinWidth="450" MaxHeight="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Batal" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Simpan" IsDefault="True"
                    Click="OnSaveClick" Padding="18,7"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Live Avatar Preview Header -->
                <DockPanel Margin="0,0,0,16">
                    <Border x:Name="AvatarPreviewBorder" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12"
                            Background="#3B82F6" Margin="0,0,14,0">
                        <TextBlock x:Name="AvatarPreviewLetter" Text="P" Foreground="White" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewTitleText" Text="Profil Baru" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Satu profil bisa dipakai untuk banyak website secara terisolasi."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Nama Profil *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" MaxLength="80" TextChanged="OnNameChanged"
                             themes:TextBoxAssist.PlaceholderText="Contoh: Kerja Utama, Akun Klien A, Pribadi..."/>
                </StackPanel>

                <!-- Curated 8-Hue Identity Color Picker (Color = Profile Identity) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Warna Identitas Profil" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel x:Name="SwatchPanel" Orientation="Horizontal">
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#2563EB" Click="OnColorSwatchClick" Tag="#2563EB" ToolTip="Biru" AutomationProperties.Name="Warna Biru"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#7C3AED" Click="OnColorSwatchClick" Tag="#7C3AED" ToolTip="Ungu" AutomationProperties.Name="Warna Ungu"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#059669" Click="OnColorSwatchClick" Tag="#059669" ToolTip="Hijau" AutomationProperties.Name="Warna Hijau"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#D97706" Click="OnColorSwatchClick" Tag="#D97706" ToolTip="Amber" AutomationProperties.Name="Warna Amber"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#E11D48" Click="OnColorSwatchClick" Tag="#E11D48" ToolTip="Merah Mawar" AutomationProperties.Name="Warna Merah Mawar"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#0891B2" Click="OnColorSwatchClick" Tag="#0891B2" ToolTip="Cyan" AutomationProperties.Name="Warna Cyan"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#4F46E5" Click="OnColorSwatchClick" Tag="#4F46E5" ToolTip="Indigo" AutomationProperties.Name="Warna Indigo"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#EA580C" Click="OnColorSwatchClick" Tag="#EA580C" ToolTip="Oranye" AutomationProperties.Name="Warna Oranye"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Grup (opsional, bisa lebih dari satu)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="10,8" MaxHeight="96">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <TextBlock x:Name="NoGroupsHint" Text="Belum ada grup. Buat grup dulu lewat tombol + pada seksi GRUP di sidebar."
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <ItemsControl x:Name="GroupsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="0,0,14,6" FontSize="12.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Progressive Disclosure: Advanced Options -->
                <Button Style="{StaticResource GhostButtonStyle}" Click="OnToggleAdvancedClick"
                        HorizontalAlignment="Left" Padding="6,5" Margin="0,2,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="AdvancedChevron" Style="{StaticResource VectorIconStyle}"
                              Data="{StaticResource IconChevronRight}" Width="12" Height="12" Margin="0,0,6,0"/>
                        <TextBlock Text="Opsi lanjutan (halaman awal, favorit, sesi)" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <Border x:Name="AdvancedOptionsPanel" Visibility="Collapsed"
                        Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Halaman Awal (opsional)" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="StartupUrlBox" Margin="0,0,0,10"
                                 themes:TextBoxAssist.PlaceholderText="Kosongkan atau isi misal: https://chatgpt.com"/>

                        <TextBlock Text="Kode Warna Kustom (Hex)" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="ColorHexBox" MaxLength="7" TextChanged="OnColorHexChanged" Margin="0,0,0,10"
                                 themes:TextBoxAssist.PlaceholderText="#2563EB"/>

                        <CheckBox x:Name="FavoriteCheck" Content="Tandai sebagai Favorit" Margin="0,2,0,8"/>
                        <CheckBox x:Name="RestoreSessionCheck" Content="Buka kembali tab terakhir saat profil dibuka" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="PersistCookiesCheck" Content="Tetap login setelah aplikasi ditutup" IsChecked="True"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerSoftTextBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="Switchly.App.Views.ProfileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Switchly.App.Themes"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Profil Browser — Switchly"
        Width="490" MinWidth="450" MaxHeight="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Batal" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Simpan" IsDefault="True"
                    Click="OnSaveClick" Padding="18,7"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Live Avatar Preview Header -->
                <DockPanel Margin="0,0,0,16">
                    <Border x:Name="AvatarPreviewBorder" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12"
                            Background="#3B82F6" Margin="0,0,14,0">
                        <TextBlock x:Name="AvatarPreviewLetter" Text="P" Foreground="White" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewTitleText" Text="Profil Baru" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Satu profil bisa dipakai untuk banyak website secara terisolasi."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Nama Profil *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" MaxLength="80" TextChanged="OnNameChanged"
                             themes:TextBoxAssist.PlaceholderText="Contoh: Kerja Utama, Akun Klien A, Pribadi..."/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Grup (bisa pilih lebih dari satu)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="10,8" MaxHeight="96">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <TextBlock x:Name="NoGroupsHint" Text="Belum ada grup. Buat grup dulu lewat tombol + pada seksi GRUP di sidebar."
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <ItemsControl x:Name="GroupsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="0,0,14,6" FontSize="12.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="URL Awal (opsional, http/https)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="StartupUrlBox"
                             themes:TextBoxAssist.PlaceholderText="Kosongkan atau isi misal: https://chatgpt.com"/>
                </StackPanel>

                <!-- Curated 8-Color Swatch Picker + Hex Input -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Warna Label" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#3B82F6" Click="OnColorSwatchClick" Tag="#3B82F6" ToolTip="Biru" AutomationProperties.Name="Warna Biru"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#6366F1" Click="OnColorSwatchClick" Tag="#6366F1" ToolTip="Indigo" AutomationProperties.Name="Warna Indigo"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#8B5CF6" Click="OnColorSwatchClick" Tag="#8B5CF6" ToolTip="Ungu" AutomationProperties.Name="Warna Ungu"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#EC4899" Click="OnColorSwatchClick" Tag="#EC4899" ToolTip="Merah Muda" AutomationProperties.Name="Warna Merah Muda"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#EF4444" Click="OnColorSwatchClick" Tag="#EF4444" ToolTip="Merah" AutomationProperties.Name="Warna Merah"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#F59E0B" Click="OnColorSwatchClick" Tag="#F59E0B" ToolTip="Kuning" AutomationProperties.Name="Warna Kuning"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,8,0" Background="#10B981" Click="OnColorSwatchClick" Tag="#10B981" ToolTip="Hijau" AutomationProperties.Name="Warna Hijau"/>
                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#06B6D4" Click="OnColorSwatchClick" Tag="#06B6D4" ToolTip="Cyan" AutomationProperties.Name="Warna Cyan"/>
                    </StackPanel>
                    <TextBox x:Name="ColorHexBox" MaxLength="7" TextChanged="OnColorHexChanged"
                             themes:TextBoxAssist.PlaceholderText="#3B82F6"/>
                </StackPanel>

                <CheckBox x:Name="FavoriteCheck" Content="Tandai sebagai Favorit" Margin="0,2,0,8"/>
                <CheckBox x:Name="RestoreSessionCheck" Content="Pulihkan sesi terakhir saat dibuka" IsChecked="True" Margin="0,0,0,8"/>
                <CheckBox x:Name="PersistCookiesCheck" Content="Simpan session cookies antar-restart" IsChecked="True" Margin="0,0,0,8"/>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerSoftTextBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

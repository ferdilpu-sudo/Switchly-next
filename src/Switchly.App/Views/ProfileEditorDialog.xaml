<Window x:Class="Switchly.App.Views.ProfileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Switchly.App.Themes"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Profil Browser — Switchly"
        Width="500" MinWidth="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="22,18,22,18">
        <!-- Always-Visible Sticky Footer (Never Clipped When Expanding Color Wheel or Advanced Options) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Simpan" IsDefault="True"
                        Click="OnSaveClick" Padding="18,7"/>
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="BodyScrollViewer" MaxHeight="440" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- Live Avatar Preview Header -->
                <DockPanel Margin="0,0,0,16">
                    <Border x:Name="AvatarPreviewBorder" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12"
                            Background="#2563EB" Margin="0,0,14,0">
                        <TextBlock x:Name="AvatarPreviewLetter" Text="P" Foreground="White" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewTitleText" Text="Profil Baru" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Satu profil bisa dipakai untuk banyak website secara terisolasi."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Nama Profil *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="NameBox" MaxLength="80" TextChanged="OnNameChanged"
                             themes:TextBoxAssist.PlaceholderText="Contoh: Kerja Utama, Akun Klien A, Pribadi..."/>
                </StackPanel>

                <!-- Curated 8-Hue Identity Color Picker + Interactive HSV Color Circle -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Warna Identitas Profil" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,4">
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,7,0" Background="#2563EB" Click="OnColorSwatchClick" Tag="#2563EB" ToolTip="Biru" AutomationProperties.Name="Warna Biru"/>
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,7,0" Background="#7C3AED" Click="OnColorSwatchClick" Tag="#7C3AED" ToolTip="Ungu" AutomationProperties.Name="Warna Ungu"/>
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,7,0" Background="#059669" Click="OnColorSwatchClick" Tag="#059669" ToolTip="Hijau" AutomationProperties.Name="Warna Hijau"/>
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,7,0" Background="#D97706" Click="OnColorSwatchClick" Tag="#D97706" ToolTip="Amber" AutomationProperties.Name="Warna Amber"/>
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,7,0" Background="#E11D48" Click="OnColorSwatchClick" Tag="#E11D48" ToolTip="Merah Mawar" AutomationProperties.Name="Warna Merah Mawar"/>
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,7,0" Background="#0891B2" Click="OnColorSwatchClick" Tag="#0891B2" ToolTip="Cyan" AutomationProperties.Name="Warna Cyan"/>
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Margin="0,0,7,0" Background="#4F46E5" Click="OnColorSwatchClick" Tag="#4F46E5" ToolTip="Indigo" AutomationProperties.Name="Warna Indigo"/>
                            <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#EA580C" Click="OnColorSwatchClick" Tag="#EA580C" ToolTip="Oranye" AutomationProperties.Name="Warna Oranye"/>
                        </StackPanel>

                        <!-- Friendly Visual Color Circle Trigger for Non-Technical Users -->
                        <Button x:Name="CustomColorToggleButton" Style="{StaticResource GhostButtonStyle}"
                                Click="OnToggleColorWheelClick" Padding="8,4" Margin="0,0,0,4"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                ToolTip="Pilih warna bebas dari lingkaran warna">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="MiniWheelIcon" Width="16" Height="16"
                                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,6,0"/>
                                <TextBlock Text="Warna Lain" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Visual Interactive Color Circle (Hue/Saturation Wheel + Brightness Slider + Optional Hex) -->
                    <Border x:Name="ColorWheelPanel" Visibility="Collapsed"
                            Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,6,0,0">
                        <DockPanel>
                            <Canvas x:Name="ColorWheelCanvas" DockPanel.Dock="Left" Width="132" Height="132"
                                    Margin="0,0,16,0" Cursor="Cross" Background="Transparent"
                                    MouseLeftButtonDown="OnColorWheelMouseDown"
                                    MouseMove="OnColorWheelMouseMove"
                                    MouseLeftButtonUp="OnColorWheelMouseUp">
                                <Image x:Name="ColorWheelImage" Width="132" Height="132"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
                                <Border x:Name="ColorWheelThumb" Width="16" Height="16" CornerRadius="8"
                                        BorderBrush="White" BorderThickness="2.2" Background="#2563EB"
                                        IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.55"/>
                                    </Border.Effect>
                                </Border>
                            </Canvas>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Klik atau geser titik pada lingkaran warna:"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="Kecerahan Warna" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <Slider x:Name="ColorBrightnessSlider" Minimum="0.28" Maximum="1.0" Value="0.90"
                                        SmallChange="0.02" LargeChange="0.1" Margin="0,0,0,10"
                                        ValueChanged="OnColorBrightnessChanged"
                                        AutomationProperties.Name="Kecerahan warna"/>

                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kode HEX (opsional):" FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="ColorHexBox" Width="96" HorizontalAlignment="Left"
                                             MaxLength="7" TextChanged="OnColorHexChanged"
                                             themes:TextBoxAssist.PlaceholderText="#2563EB"/>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Grup (opsional, bisa lebih dari satu)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="10,8" MaxHeight="96">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <TextBlock x:Name="NoGroupsHint" Text="Belum ada grup. Buat grup dulu lewat tombol + pada seksi GRUP di sidebar."
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <ItemsControl x:Name="GroupsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="0,0,14,6" FontSize="12.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- Progressive Disclosure: Advanced Options -->
                <Button Style="{StaticResource GhostButtonStyle}" Click="OnToggleAdvancedClick"
                        HorizontalAlignment="Left" Padding="6,5" Margin="0,2,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path x:Name="AdvancedChevron" Style="{StaticResource VectorIconStyle}"
                              Data="{StaticResource IconChevronRight}" Width="12" Height="12" Margin="0,0,6,0"/>
                        <TextBlock Text="Opsi lanjutan (halaman awal, favorit, sesi)" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>

                <Border x:Name="AdvancedOptionsPanel" Visibility="Collapsed"
                        Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Halaman Awal (opsional)" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="StartupUrlBox" Margin="0,0,0,10"
                                 themes:TextBoxAssist.PlaceholderText="Kosongkan atau isi misal: https://chatgpt.com"/>

                        <CheckBox x:Name="FavoriteCheck" Content="Tandai sebagai Favorit" Margin="0,2,0,8"/>
                        <CheckBox x:Name="RestoreSessionCheck" Content="Buka kembali tab terakhir saat profil dibuka" IsChecked="True" Margin="0,0,0,8"/>
                        <CheckBox x:Name="PersistCookiesCheck" Content="Tetap login setelah aplikasi ditutup" IsChecked="True"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerSoftTextBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

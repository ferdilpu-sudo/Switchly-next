<Window x:Class="Switchly.App.Views.CredentialPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilih Akun untuk Autofill"
        Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Isi Form" Click="OnSelectClick" IsDefault="True"
                    Background="#1B6EF3" Foreground="White" FontWeight="SemiBold" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="Batal" IsCancel="True" Padding="14,6"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Ditemukan beberapa akun untuk situs ini. Pilih akun yang ingin diisi:"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <ListBox x:Name="CredentialsList" MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Origin}" FontSize="11" Foreground="#6B7280"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

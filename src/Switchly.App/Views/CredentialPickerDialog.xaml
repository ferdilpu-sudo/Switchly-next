<Window x:Class="Switchly.App.Views.CredentialPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Pilih Akun untuk Autofill — Switchly"
        Height="340" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Batal" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Isi Form"
                    Click="OnSelectClick" IsDefault="True" Padding="18,7"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="Ditemukan beberapa akun untuk situs ini. Pilih akun yang ingin diisi:"
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ListBox x:Name="CredentialsList" Background="{DynamicResource BgSurfaceBrush}"
                 MouseDoubleClick="OnListDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6,4">
                        <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="13" LineHeight="18"/>
                        <TextBlock Text="{Binding Origin}" FontSize="11.5" LineHeight="17" Padding="0,0,0,1"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

<Window x:Class="Switchly.App.Views.SecurityAndBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Switchly.App.Themes"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Keamanan Lokal, Vault &amp; Cadangan — Switchly"
        Height="650" Width="690"
        MinHeight="550" MinWidth="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelOpButton" Style="{StaticResource DangerButtonStyle}"
                    Content="Batalkan Operasi" Click="OnCancelOperationClick"
                    Padding="14,7" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button Content="Tutup" IsCancel="True" Padding="16,7"/>
        </StackPanel>

        <TabControl>
            <!-- Tab 1: Local Security (UI-010) -->
            <TabItem Header="Keamanan Lokal">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Perlindungan Lokal Windows" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Background="{DynamicResource BgAppBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="DpapiStatusText" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="HelloStatusText" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Kata Sandi Utama (Opsional)" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,8"/>
                        <Border Background="{DynamicResource WarningSoftBgBrush}" BorderBrush="{DynamicResource WarningSoftBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningSoftTextBrush}" FontSize="12"
                                       Text="Kata sandi utama mengunci pembukaan aplikasi di komputer ini menggunakan enkripsi bawaan akun Windows Anda. Jika lupa, kata sandi tidak dapat dipulihkan."/>
                        </Border>

                        <!-- Enable Master Password -->
                        <StackPanel x:Name="EnableMasterPasswordPanel">
                            <TextBlock Text="Kata sandi utama baru (minimal 8 karakter):" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="NewMasterPasswordBox" Margin="0,0,0,10"/>
                            <TextBlock Text="Konfirmasi kata sandi utama:" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="ConfirmMasterPasswordBox" Margin="0,0,0,12"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Aktifkan Kunci Kata Sandi Utama"
                                    Click="OnEnableMasterPasswordClick" Padding="16,7" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Disable Master Password -->
                        <StackPanel x:Name="DisableMasterPasswordPanel" Visibility="Collapsed">
                            <TextBlock Text="Kunci kata sandi utama saat ini AKTIF." Foreground="{DynamicResource SuccessTextBrush}"
                                       FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Masukkan kata sandi utama saat ini untuk menonaktifkan:" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="CurrentMasterPasswordBox" Margin="0,0,0,12"/>
                            <Button Content="Nonaktifkan Kunci Kata Sandi Utama" Click="OnDisableMasterPasswordClick"
                                    Padding="14,7" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <TextBlock x:Name="SecurityFeedbackText" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Manual Backup & Restore (UI-011) -->
            <TabItem Header="Cadangan &amp; Pulihkan Manual">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Background="{DynamicResource InfoSoftBgBrush}" BorderBrush="{DynamicResource InfoSoftBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InfoSoftTextBrush}" FontSize="12"
                                       Text="Cadangan manual terenkripsi AES-256-GCM (chunked streaming). Cache sementara dan cookies sesi perangkat TIDAK disertakan — pada komputer baru Anda perlu login ulang ke website."/>
                        </Border>

                        <!-- Create Manual Backup -->
                        <TextBlock Text="Buat Cadangan Terenkripsi (.snbak)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Passphrase enkripsi (minimal 8 karakter — simpan baik-baik, tidak dapat dipulihkan jika hilang):"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="BackupPassphraseBox" Margin="0,0,0,8"/>
                        <TextBlock Text="Konfirmasi passphrase:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="BackupPassphraseConfirmBox" Margin="0,0,0,12"/>
                        <Button x:Name="CreateBackupButton" Style="{StaticResource PrimaryButtonStyle}"
                                Content="Pilih Lokasi &amp; Buat Cadangan..." Click="OnCreateBackupClick"
                                Padding="16,7" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <Separator Margin="0,2,0,16"/>

                        <!-- Restore from Backup (Restart-to-Restore) -->
                        <TextBlock Text="Pulihkan dari Arsip Cadangan (Restart-to-Restore)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Pilih File..." Click="OnBrowseRestoreArchiveClick"
                                    Padding="12,6" Margin="8,0,0,0"/>
                            <TextBox x:Name="RestoreArchivePathBox" IsReadOnly="True"
                                     themes:TextBoxAssist.PlaceholderText="Pilih file arsip cadangan (.snbak)..."
                                     ToolTip="Path file cadangan terenkripsi"/>
                        </DockPanel>

                        <Border x:Name="RestorePreviewCard" Background="{DynamicResource BgAppBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="12" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="RestorePreviewText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Passphrase arsip backup:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="RestorePassphraseBox" Margin="0,0,0,12"/>
                        <Button x:Name="StageRestoreButton" Content="Verifikasi &amp; Siapkan Pemulihan (Restart)"
                                Click="OnStageRestoreClick" Padding="14,7" HorizontalAlignment="Left"/>

                        <!-- Progress & Status -->
                        <ProgressBar x:Name="OperationProgressBar" Height="8" Minimum="0" Maximum="1" Margin="0,16,0,6" Visibility="Collapsed"/>
                        <TextBlock x:Name="BackupStatusText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Password Vault & CSV Import (ENT-009, TASK-028, D6) -->
            <TabItem Header="Password Vault &amp; CSV">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Background="{DynamicResource InfoSoftBgBrush}" BorderBrush="{DynamicResource InfoSoftBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InfoSoftTextBrush}" FontSize="12"
                                       Text="Kredensial dienkripsi per profil dengan AES-256-GCM (nonce unik + AAD) dan kunci yang dilindungi Windows DPAPI. Isi otomatis hanya aktif saat Anda klik ikon Kunci (Autofill) pada origin situs yang cocok."/>
                        </Border>

                        <TextBlock Text="Profil Switchly:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="VaultProfileCombo" SelectionChanged="OnVaultProfileChanged"
                                  Padding="10,6" Margin="0,0,0,14" AutomationProperties.Name="Pilih profil Switchly">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- CSV Import (TASK-028) -->
                        <TextBlock Text="Impor Password CSV (Ekspor Resmi Chrome / Edge)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Ekspor password dari Chrome/Edge ke file .csv, impor ke profil di atas, lalu hapus file .csv plaintext setelah selesai."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Pilih File CSV &amp; Impor ke Vault..."
                                Click="OnImportCsvPasswordsClick" Padding="16,7" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <Separator Margin="0,2,0,14"/>

                        <!-- Manual Add Credential -->
                        <TextBlock Text="Tambah / Perbarui Kredensial Manual" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="URL / Origin (contoh: https://chatgpt.com)" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="VaultOriginBox" themes:TextBoxAssist.PlaceholderText="https://chatgpt.com"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Username / Email" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="VaultUsernameBox" themes:TextBoxAssist.PlaceholderText="email@contoh.com"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Kata Sandi:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Simpan ke Vault" Click="OnSaveCredentialClick"
                                    Padding="14,6" Margin="8,0,0,0"/>
                            <PasswordBox x:Name="VaultPasswordBox"/>
                        </DockPanel>

                        <TextBlock x:Name="VaultFeedbackText" FontSize="12" Foreground="{DynamicResource SuccessTextBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Saved Credentials List (Origin & Username only — NEVER displays plaintext password) -->
                        <TextBlock Text="Kredensial Tersimpan di Profil Ini:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid MinHeight="88">
                            <ListBox x:Name="VaultCredentialsList" MaxHeight="200" Background="{DynamicResource BgAppBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True" Margin="4,2">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButtonStyle}"
                                                    Content="Hapus" Click="OnDeleteCredentialClick" Tag="{Binding}"
                                                    Padding="10,4" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Origin}" FontWeight="SemiBold" FontSize="12.5" LineHeight="18"/>
                                                <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="11.5" LineHeight="17" Padding="0,0,0,1"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Belum ada kredensial tersimpan di profil ini. Impor CSV atau tambahkan manual di atas."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=VaultCredentialsList}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

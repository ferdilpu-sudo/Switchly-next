<Window x:Class="Switchly.App.Views.ImportWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impor Data Browser (Chrome / Edge)"
        Height="600" Width="640"
        MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="18">
        <!-- Bottom Action Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="PreviewButton" Content="Pratinjau" Click="OnPreviewClick" Padding="14,7" Margin="0,0,8,0"/>
            <Button x:Name="ExecuteButton" Content="Mulai Impor" Click="OnExecuteClick"
                    Background="#1B6EF3" Foreground="White" FontWeight="SemiBold" Padding="16,7" Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="Tutup" IsCancel="True" Padding="14,7"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Impor dari Chrome atau Edge" FontSize="17" FontWeight="Bold" Margin="0,0,0,6"/>

                <!-- Explicit REQ-009 / D1 Privacy Notice -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock TextWrapping="Wrap" Foreground="#1E40AF" FontSize="12"
                               Text="Impor bersifat baca-saja (tidak mengubah Chrome/Edge). Cookies, sesi login, dan kata sandi TIDAK dibawa — Anda perlu login ulang di Switchly Next."/>
                </Border>

                <!-- Step 1: Source Browser & Profile -->
                <TextBlock Text="1. Pilih Browser &amp; Profil Sumber" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Muat Ulang" Click="OnRefreshSourcesClick" Padding="10,4" Margin="8,0,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="ChromeRadio" Content="Google Chrome" GroupName="SourceBrowser" IsChecked="True"
                                     Checked="OnBrowserFilterChanged" Margin="0,0,16,0"/>
                        <RadioButton x:Name="EdgeRadio" Content="Microsoft Edge" GroupName="SourceBrowser"
                                     Checked="OnBrowserFilterChanged"/>
                    </StackPanel>
                </DockPanel>

                <ComboBox x:Name="SourceProfileCombo" DisplayMemberPath="DisplayLabel" Margin="0,0,0,4" Padding="8,5"/>
                <TextBlock x:Name="SourceEmptyHint" Foreground="#B45309" FontSize="12" Visibility="Collapsed" Margin="0,0,0,8"
                           Text="Tidak ada profil lokal yang terdeteksi untuk browser ini."/>

                <!-- Step 2: Target Switchly Profile -->
                <TextBlock Text="2. Pilih Profil Tujuan di Switchly Next" FontWeight="SemiBold" Margin="0,10,0,6"/>
                <ComboBox x:Name="TargetProfileCombo" DisplayMemberPath="Name" Margin="0,0,0,10" Padding="8,5"/>

                <!-- Step 3: Categories -->
                <TextBlock Text="3. Pilih Kategori Data" FontWeight="SemiBold" Margin="0,2,0,6"/>
                <StackPanel Margin="4,0,0,10">
                    <CheckBox x:Name="BookmarksCheck" Content="Bookmark (termasuk struktur folder)" IsChecked="True" Margin="0,0,0,4"/>
                    <CheckBox x:Name="HistoryCheck" Content="Riwayat Kunjungan (tutup Chrome/Edge jika database terkunci)" IsChecked="True" Margin="0,0,0,4"/>
                    <CheckBox x:Name="OpenTabsCheck" Content="Tab Terbuka (URL saja, format SNSS)" IsChecked="False"/>
                </StackPanel>

                <!-- Step 4: Locked DB / Status / Preview & Result -->
                <Border x:Name="LockedWarningBanner" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="5"
                        Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Foreground="#92400E" FontSize="12"
                               Text="Database riwayat sedang terkunci oleh browser sumber. Tutup Google Chrome atau Microsoft Edge terlebih dahulu, lalu klik Pratinjau ulang."/>
                </Border>

                <Border x:Name="SummaryCard" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="5"
                        Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SummaryHeaderText" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SummaryBodyText" TextWrapping="Wrap" FontSize="12" Foreground="#374151"/>
                        <ItemsControl x:Name="WarningsList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" Foreground="#B45309" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="BusyStatusText" Foreground="#1B6EF3" FontSize="12" Visibility="Collapsed" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

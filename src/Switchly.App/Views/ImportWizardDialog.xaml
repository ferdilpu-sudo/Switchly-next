<Window x:Class="Switchly.App.Views.ImportWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Impor Data Browser (Chrome / Edge) — Switchly"
        Height="570" Width="650"
        MinHeight="460" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <!-- Bottom Action Buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Tutup" IsCancel="True" Padding="16,7" Margin="0,0,8,0"/>
                <Button x:Name="PreviewButton" Content="Pratinjau" Click="OnPreviewClick" Padding="16,7" Margin="0,0,8,0"/>
                <Button x:Name="ExecuteButton" Style="{StaticResource PrimaryButtonStyle}" Content="Mulai Impor"
                        Click="OnExecuteClick" Padding="18,7" IsEnabled="False"/>
            </StackPanel>
            <TextBlock Text="Klik Pratinjau dulu untuk mengaktifkan Mulai Impor."
                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=ExecuteButton}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Impor dari Chrome atau Edge" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Explicit REQ-009 Privacy Notice -->
                <Border Background="{DynamicResource InfoSoftBgBrush}" BorderBrush="{DynamicResource InfoSoftBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource InfoSoftTextBrush}" FontSize="12"
                               Text="Impor bersifat baca-saja (tidak mengubah Chrome/Edge). Cookies, sesi login, dan kata sandi TIDAK dibawa — Anda perlu login ulang di Switchly."/>
                </Border>

                <!-- Step 1: Source Browser & Profile -->
                <TextBlock Text="1. Pilih Browser &amp; Profil Sumber" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Muat Ulang" Click="OnRefreshSourcesClick" Padding="12,5" Margin="8,0,0,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="ChromeRadio" Content="Google Chrome" GroupName="SourceBrowser" IsChecked="True"
                                     Checked="OnBrowserFilterChanged" Margin="0,0,18,0"/>
                        <RadioButton x:Name="EdgeRadio" Content="Microsoft Edge" GroupName="SourceBrowser"
                                     Checked="OnBrowserFilterChanged"/>
                    </StackPanel>
                </DockPanel>

                <ComboBox x:Name="SourceProfileCombo" Margin="0,0,0,4" Padding="10,6"
                          SelectionChanged="OnImportInputsChanged"
                          AutomationProperties.Name="Pilih profil browser sumber">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FriendlyLabel}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="SourceEmptyHint" Foreground="{DynamicResource WarningSoftTextBrush}"
                           FontSize="12" Visibility="Collapsed" Margin="0,2,0,8"
                           Text="Tidak ada profil lokal yang terdeteksi untuk browser ini."/>

                <!-- Step 2: Target Switchly Profile -->
                <TextBlock Text="2. Pilih Profil Tujuan di Switchly" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <ComboBox x:Name="TargetProfileCombo" Margin="0,0,0,12" Padding="10,6"
                          SelectionChanged="OnImportInputsChanged"
                          AutomationProperties.Name="Pilih profil tujuan Switchly">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Step 3: Categories -->
                <TextBlock Text="3. Pilih Kategori Data" FontWeight="SemiBold" Margin="0,2,0,8"/>
                <StackPanel Margin="4,0,0,12">
                    <CheckBox x:Name="BookmarksCheck" Content="Bookmark (termasuk struktur folder)" IsChecked="True"
                              Click="OnImportInputsChanged" Margin="0,0,0,6"/>
                    <CheckBox x:Name="HistoryCheck" Content="Riwayat Kunjungan (tutup Chrome/Edge jika database terkunci)" IsChecked="True"
                              Click="OnImportInputsChanged" Margin="0,0,0,6"/>
                    <CheckBox x:Name="OpenTabsCheck" Content="Tab Terbuka (hanya alamat URL)" IsChecked="False"
                              Click="OnImportInputsChanged"/>
                </StackPanel>

                <!-- Step 4: Locked DB / Status / Preview & Result -->
                <Border x:Name="LockedWarningBanner" Background="{DynamicResource WarningSoftBgBrush}"
                        BorderBrush="{DynamicResource WarningSoftBorderBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WarningSoftTextBrush}" FontSize="12"
                               Text="Database riwayat sedang terkunci oleh browser sumber. Tutup Google Chrome atau Microsoft Edge terlebih dahulu, lalu klik Pratinjau ulang."/>
                </Border>

                <Border x:Name="SummaryCard" Background="{DynamicResource BgSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="14" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SummaryHeaderText" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SummaryBodyText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ItemsControl x:Name="WarningsList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource WarningSoftTextBrush}"
                                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="BusyStatusText" Foreground="{DynamicResource AccentBrush}"
                           FontSize="12" Visibility="Collapsed" Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

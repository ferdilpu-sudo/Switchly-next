<Window x:Class="Switchly.App.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ThemedWindowStyle}"
        Width="420" MaxHeight="300"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox" MaxLength="80" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Batal" IsCancel="True" Padding="14,6" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Simpan"
                    IsDefault="True" Click="OnOkClick" Padding="16,6"/>
        </StackPanel>
    </StackPanel>
</Window>

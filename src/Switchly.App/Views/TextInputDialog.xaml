<Window x:Class="Switchly.App.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="170" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="PromptText" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox Grid.Row="1" x:Name="InputBox" MaxLength="80" Padding="6,4"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Batal" IsCancel="True" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="Simpan" IsDefault="True" Click="OnOkClick" Padding="14,5" Background="#1B6EF3" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>

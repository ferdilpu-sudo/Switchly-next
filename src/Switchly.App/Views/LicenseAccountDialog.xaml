<Window x:Class="Switchly.App.Views.LicenseAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Switchly.App.Themes"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Akun &amp; Lisensi — Switchly"
        Width="540"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,20">
            <!-- Header + Current Plan Badge -->
            <DockPanel Margin="0,0,0,14">
                <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="PlanBadgeText" Text="Free Beta" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Akun &amp; Lisensi Switchly" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="AccountSubtitleText"
                               Text="Mode Free (maks. 5 profil) berjalan 100% lokal tanpa login."
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Optional Context / Quota Banner -->
            <Border x:Name="InfoBanner" Visibility="Collapsed"
                    Background="{DynamicResource BgSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                <TextBlock x:Name="InfoBannerText" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>

            <!-- Section 1: Optional Email OTP Login -->
            <Border x:Name="LoginSection" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Masuk / Daftar Akun (Email OTP)" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Hanya diperlukan untuk mengaktifkan Trial Pro 7 hari gratis atau lisensi Pro. Tanpa password dan tanpa kartu kredit."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="SendOtpButton" DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                Content="Kirim OTP" Click="OnSendOtpClick" Padding="12,6" Margin="8,0,0,0"/>
                        <TextBox x:Name="EmailTextBox"
                                 themes:TextBoxAssist.PlaceholderText="nama@email.com"
                                 KeyDown="OnEmailBoxKeyDown"
                                 ToolTip="Masukkan alamat email permanen Anda"/>
                    </DockPanel>

                    <DockPanel x:Name="OtpVerifyRow" Visibility="Collapsed">
                        <Button x:Name="VerifyOtpButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                Content="Verifikasi OTP" Click="OnVerifyOtpClick" Padding="12,6" Margin="8,0,0,0"/>
                        <TextBox x:Name="OtpCodeTextBox" MaxLength="6"
                                 themes:TextBoxAssist.PlaceholderText="Masukkan 6 digit kode OTP"
                                 KeyDown="OnOtpCodeBoxKeyDown"
                                 ToolTip="Masukkan kode OTP 6 digit dari email"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Section 2: Signed-in Account, 7-Day Trial & Midtrans Pro Checkout -->
            <Border x:Name="SignedInSection" Visibility="Collapsed" Background="{DynamicResource BgSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="SignOutButton" DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                Content="Keluar Akun" Click="OnSignOutClick" Padding="10,5" FontSize="12"/>
                        <StackPanel>
                            <TextBlock x:Name="SignedInEmailText" Text="user@example.com" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="LicenseExpiryText" Text="Status: Free" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Button x:Name="StartTrialButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="Aktifkan Trial Pro 7 Hari Gratis (Tanpa Kartu Kredit)"
                            Click="OnStartTrialClick" Padding="14,8" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Upgrade ke Switchly Pro (Midtrans — QRIS, Virtual Account, E-Wallet)"
                               FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,8"/>

                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <Button x:Name="CheckoutMonthlyButton" Style="{StaticResource GhostButtonStyle}" Click="OnCheckoutMonthlyClick" Padding="8,10" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Bulanan" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Rp 39.000/bln" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CheckoutAnnualButton" Style="{StaticResource PrimaryButtonStyle}" Click="OnCheckoutAnnualClick" Padding="8,10" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Tahunan ★" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Rp 249.000/thn" FontSize="11.5" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CheckoutPerpetualButton" Style="{StaticResource GhostButtonStyle}" Click="OnCheckoutPerpetualClick" Padding="8,10" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Bayar Sekali" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Rp 399.000" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Button x:Name="RefreshLicenseButton" Style="{StaticResource GhostButtonStyle}"
                            Content="Perbarui Status Lisensi (Setelah Bayar QRIS/VA)"
                            Click="OnRefreshLicenseClick" Padding="12,7" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Status feedback -->
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" Margin="2,0,2,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButtonStyle}" Content="Tutup" IsCancel="True"
                        Click="OnCloseClick" Padding="16,7"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

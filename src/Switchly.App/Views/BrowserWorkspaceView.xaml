<UserControl x:Class="Switchly.App.Views.BrowserWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Switchly.App.Themes"
             Background="{DynamicResource BgAppBrush}"
             PreviewKeyDown="OnWorkspacePreviewKeyDown">
    <DockPanel>
        <!-- Persistent 3px Profile Identity Accent Stripe ("Warna adalah identitas profil" — WCAG 1.4.1 paired with initial + name below) -->
        <Border x:Name="ProfileColorStripe" DockPanel.Dock="Top" Height="3" Background="{DynamicResource AccentBrush}"/>

        <!-- Row 1: Unified Profile Switcher + Browser Tab Strip (2-Row Browser Chrome Consolidation) -->
        <Border x:Name="TabStripBar" DockPanel.Dock="Top" Panel.ZIndex="2" ClipToBounds="False"
                Background="{DynamicResource BgTabStripBrush}" Padding="8,6,8,0">
            <DockPanel ClipToBounds="False">
                <!-- Sidebar Toggle (visible when docked inside MainWindow) -->
                <Button x:Name="BrowserSidebarToggleButton" DockPanel.Dock="Left"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnToggleHostSidebarClick"
                        Width="30" Height="30" MinWidth="30" Margin="0,0,6,5"
                        Visibility="Collapsed"
                        ToolTip="Ciutkan / Tampilkan Sidebar (Ctrl+B)"
                        AutomationProperties.Name="Ciutkan atau tampilkan sidebar">
                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconSidebar}" Width="15" Height="15"/>
                </Button>

                <!-- Prominent Colored Profile Identity & Session Switcher Pill [● Inisial  Nama Profil ▾] -->
                <Button x:Name="ProfileBadgeButton" DockPanel.Dock="Left"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="OnProfileBadgeMenuClick"
                        Padding="6,4,9,4" Margin="0,0,8,5"
                        BorderThickness="1.5"
                        ToolTip="Identitas profil aktif — klik untuk pindah sesi, kembali ke daftar profil, atau tutup sesi"
                        AutomationProperties.Name="Menu profil aktif">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ProfileBadge" Width="20" Height="20" CornerRadius="6"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,7,0">
                            <TextBlock x:Name="ProfileInitialText" Text="P" Foreground="White" FontSize="11.5"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="ProfileNameText" FontSize="12.5" FontWeight="SemiBold"
                                   MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Path x:Name="ProfileMenuChevron" Style="{StaticResource VectorIconStyle}"
                              Data="{StaticResource IconChevronDown}" Width="11" Height="11" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}"
                        Click="OnNewTabClick" Margin="6,0,0,4"
                        ToolTip="Tab baru (Ctrl+T)" AutomationProperties.Name="Tab baru">
                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}" Width="15" Height="15"/>
                </Button>

                <ListBox x:Name="TabStrip" BorderThickness="0" Background="Transparent" Padding="0" ClipToBounds="False"
                         ItemContainerStyle="{StaticResource BrowserTabItemStyle}"
                         SelectionChanged="OnTabSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel MouseDown="OnTabItemMouseDown" Tag="{Binding}">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Muat Ulang Tab" Click="OnTabReloadContextClick" Tag="{Binding}"/>
                                        <MenuItem Header="Duplikat Tab" Click="OnTabDuplicateContextClick" Tag="{Binding}"/>
                                        <MenuItem Header="Salin URL Tab" Click="OnTabCopyUrlContextClick" Tag="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Tutup Tab" Click="OnCloseTabClick" Tag="{Binding}"/>
                                        <MenuItem Header="Tutup Tab Lainnya" Click="OnCloseOtherTabsContextClick" Tag="{Binding}"/>
                                        <MenuItem Header="Buka Kembali Tab Tertutup (Ctrl+Shift+T)" Click="OnReopenClosedTabContextClick"/>
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <DockPanel.ToolTip>
                                    <StackPanel MaxWidth="360">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel.ToolTip>
                                <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                        Click="OnCloseTabClick" Tag="{Binding}"
                                        Width="22" Height="22" Padding="5" Margin="8,0,0,0"
                                        ToolTip="Tutup tab ini (Ctrl+W)" AutomationProperties.Name="Tutup tab">
                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="10" Height="10"/>
                                </Button>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontSize="12.5"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Row 2: Calm Navigation Toolbar (Omnibox Tinted by Profile Identity + Grouped Overflow Menu) -->
        <Border x:Name="NavigationToolbarBar" DockPanel.Dock="Top" Background="{DynamicResource BgTabActiveBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,1" Padding="8,6">
            <DockPanel>
                <!-- Left Navigation Controls -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="BackButton" Style="{StaticResource IconButtonStyle}" Click="OnBackClick" Margin="0,0,2,0"
                            ToolTip="Kembali" AutomationProperties.Name="Kembali">
                        <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconArrowLeft}"/>
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource IconButtonStyle}" Click="OnForwardClick" Margin="0,0,2,0"
                            ToolTip="Maju" AutomationProperties.Name="Maju">
                        <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconArrowRight}"/>
                    </Button>
                    <Button x:Name="ReloadButton" Style="{StaticResource IconButtonStyle}" Click="OnReloadClick"
                            ToolTip="Muat ulang / Hentikan (F5 / Ctrl+R)" AutomationProperties.Name="Muat ulang atau hentikan">
                        <Path x:Name="ReloadIconPath" Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconRefresh}"/>
                    </Button>
                </StackPanel>

                <!-- Right Primary Actions (Autofill + Downloads + Grouped ⋯ Menu) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="AutofillToolbarButton" Style="{StaticResource IconButtonStyle}" Click="OnAutofillPasswordClick" Margin="0,0,2,0"
                            ToolTip="Isi otomatis sandi pada situs ini"
                            AutomationProperties.Name="Isi otomatis sandi">
                        <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconKey}"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}" Click="OnShowDownloadsClick" Margin="0,0,2,0"
                            ToolTip="Unduhan profil ini"
                            AutomationProperties.Name="Unduhan">
                        <Grid>
                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconDownload}"/>
                            <Ellipse x:Name="DownloadActiveDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="BrowserMoreButton" Style="{StaticResource IconButtonStyle}" Click="OnBrowserMoreMenuClick"
                            ToolTip="Menu browser (Bookmark, Riwayat, Cari di Halaman, Jendela Baru)"
                            AutomationProperties.Name="Menu browser lainnya">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Simpan Halaman ke Bookmark" Click="OnBookmarkMenuClick"/>
                                <MenuItem Header="Kelola Bookmark..." Click="OnManageBookmarksMenuClick"/>
                                <MenuItem Header="Riwayat Kunjungan..." Click="OnShowHistoryClick"/>
                                <MenuItem Header="Semua Unduhan..." Click="OnOpenFullDownloadsClick"/>
                                <Separator/>
                                <MenuItem Header="Cari di Halaman (Ctrl+F)" Click="OnFindToggleClick"/>
                                <MenuItem Header="Buka di Jendela Baru" Click="OnNewWindowClick"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconMoreHorizontal}"/>
                    </Button>
                </StackPanel>

                <!-- Unified Modern Pill Omnibox with Subtle Profile Color Identity Dot -->
                <Border x:Name="OmniboxChromeBorder" Background="{DynamicResource BgInputBrush}"
                        CornerRadius="18" Height="36" Padding="10,0,4,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{Binding Background, ElementName=ProfileColorStripe}"/>
                                    <Setter Property="BorderThickness" Value="1.8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Ellipse x:Name="OmniboxProfileDot" DockPanel.Dock="Left" Width="7" Height="7"
                                 Fill="{Binding Background, ElementName=ProfileColorStripe}"
                                 VerticalAlignment="Center" Margin="1,0,7,0"
                                 ToolTip="Warna identitas profil aktif"/>
                        <Path x:Name="SecurityIconPath" DockPanel.Dock="Left"
                              Data="{StaticResource IconGlobe}"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                              ToolTip="Status koneksi halaman"/>

                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                Click="OnNavigateClick" Width="26" Height="26" Padding="5"
                                ToolTip="Buka URL atau cari (Enter)" AutomationProperties.Name="Buka URL">
                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconCornerDownLeft}" Width="12" Height="12"/>
                        </Button>

                        <Button x:Name="ZoomBadgeButton" DockPanel.Dock="Right"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="100%" FontSize="11" FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentBrush}"
                                Padding="7,2" Margin="0,0,4,0" Visibility="Collapsed"
                                Click="OnResetZoomClick"
                                ToolTip="Klik untuk reset zoom ke 100% (Ctrl+0)"
                                AutomationProperties.Name="Reset zoom ke 100 persen"/>

                        <TextBox x:Name="AddressBox"
                                 Style="{StaticResource BorderlessTextBoxStyle}"
                                 themes:TextBoxAssist.PlaceholderText="Masukkan URL atau cari di Google (Ctrl+L)..."
                                 KeyDown="OnAddressBoxKeyDown"
                                 GotKeyboardFocus="OnAddressBoxGotKeyboardFocus"
                                 PreviewMouseLeftButtonDown="OnAddressBoxPreviewMouseLeftButtonDown"
                                 AutomationProperties.Name="Address bar"
                                 ToolTip="Address bar (Ctrl+L)">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Potong" Command="ApplicationCommands.Cut"/>
                                    <MenuItem Header="Salin" Command="ApplicationCommands.Copy"/>
                                    <MenuItem Header="Tempel" Command="ApplicationCommands.Paste"/>
                                    <MenuItem Header="Tempel &amp; Buka" Click="OnAddressPasteAndGoClick"/>
                                    <Separator/>
                                    <MenuItem Header="Pilih Semua" Command="ApplicationCommands.SelectAll"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Subtle 2px Indeterminate Loading Bar -->
        <ProgressBar x:Name="LoadingProgressBar" DockPanel.Dock="Top" Height="2"
                     IsIndeterminate="True" Visibility="Collapsed"/>

        <!-- Inline Find-in-Page Bar (Ctrl+F) -->
        <Border x:Name="FindBar" DockPanel.Dock="Top"
                Background="{DynamicResource BgSurfaceElevatedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1" Padding="10,6" Visibility="Collapsed">
            <DockPanel HorizontalAlignment="Right">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" MinWidth="28"
                        Click="OnCloseFindClick" Margin="4,0,0,0"
                        ToolTip="Tutup pencarian (Esc)" AutomationProperties.Name="Tutup pencarian">
                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="12" Height="12"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" MinWidth="28"
                        Click="OnFindNextClick" Margin="4,0,0,0"
                        ToolTip="Hasil berikutnya (Enter)" AutomationProperties.Name="Hasil berikutnya">
                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconChevronDown}" Width="13" Height="13"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="28" Height="28" MinWidth="28"
                        Click="OnFindPreviousClick" Margin="6,0,0,0"
                        ToolTip="Hasil sebelumnya (Shift+Enter)" AutomationProperties.Name="Hasil sebelumnya">
                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconChevronUp}" Width="13" Height="13"/>
                </Button>
                <TextBox x:Name="FindBox" Width="260" Height="32" MinHeight="32" Padding="10,4"
                         themes:TextBoxAssist.PlaceholderText="Cari di halaman..."
                         TextChanged="OnFindBoxTextChanged"
                         KeyDown="OnFindBoxKeyDown"
                         AutomationProperties.Name="Cari teks di halaman"/>
            </DockPanel>
        </Border>

        <!-- Non-Modal Renderer Crash Recovery Banner -->
        <Border x:Name="CrashRecoveryBanner" DockPanel.Dock="Top"
                Background="{DynamicResource DangerSoftBgBrush}"
                BorderBrush="{DynamicResource DangerSoftBorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButtonStyle}"
                        Content="Muat Ulang Tab" Click="OnRecoverCrashedTabClick"
                        Padding="12,5" Margin="10,0,0,0"/>
                <TextBlock x:Name="CrashRecoveryMessageText" Foreground="{DynamicResource DangerSoftTextBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Browser Surface + Non-Blocking Overlays (Initial Loading + Hover URL Bubble + Toast Pill) -->
        <Grid>
            <ContentControl x:Name="BrowserContainer"/>

            <!-- Non-Blocking Initial Page Loading Indicator (prevents blank white screen feel while heavy sites like SeaArt load) -->
            <Border x:Name="InitialLoadingOverlay"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BgSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="20" Padding="16,9"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.16"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSpinnerArc}"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Stretch="Uniform"
                          Width="15" Height="15"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.85"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <TextBlock Text="Memuat halaman..." FontSize="12.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Bottom-Left Chrome-Style Link Hover Status Bubble -->
            <Border x:Name="HoverStatusBubble"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="8,0,8,6" MaxWidth="520"
                    Background="{DynamicResource BgSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="9,4"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.14"/>
                </Border.Effect>
                <TextBlock x:Name="HoverStatusText" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <!-- Top-Right Native-Browser Download Flyout Popover -->
            <Border x:Name="DownloadFlyoutPanel"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12,8,12,12" Width="370" MaxHeight="380"
                    Background="{DynamicResource BgSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="14,12"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.22"/>
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" MinWidth="26"
                                Click="OnCloseDownloadFlyoutClick" ToolTip="Tutup panel unduhan" AutomationProperties.Name="Tutup panel unduhan">
                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="11" Height="11"/>
                        </Button>
                        <TextBlock Text="Unduhan Terbaru" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButtonStyle}"
                            Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"
                            Click="OnOpenFullDownloadsClick" Margin="0,8,0,0" Padding="8,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Lihat semua riwayat unduhan" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconArrowRight}"
                                  Stroke="{DynamicResource AccentBrush}" Width="13" Height="13"/>
                        </StackPanel>
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <StackPanel>
                            <TextBlock x:Name="DownloadFlyoutEmptyText"
                                       Text="Belum ada unduhan pada profil ini."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,18"/>

                            <ItemsControl x:Name="DownloadFlyoutList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgSurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Button Width="28" Height="28" MinWidth="28"
                                                                Click="OnFlyoutOpenFileClick" Tag="{Binding}"
                                                                ToolTip="Buka file" AutomationProperties.Name="Buka file">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconExternalLink}" Width="13" Height="13"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" MinWidth="28"
                                                                Click="OnFlyoutShowInFolderClick" Tag="{Binding}"
                                                                ToolTip="Tampilkan di File Explorer" AutomationProperties.Name="Tampilkan di folder">
                                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconFolder}" Width="13" Height="13"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding StatusColor}"
                                                             VerticalAlignment="Center" Margin="0,0,9,0"/>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding StatusSummary}" FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                                             Margin="0,7,0,0">
                                                    <ProgressBar.Style>
                                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInProgress}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ProgressBar.Style>
                                                </ProgressBar>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Top-Right Modern Anchored Autofill Popover (replaces legacy Windows MessageBox — Heuristic #4) -->
            <Border x:Name="AutofillFlyoutPanel"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12,8,12,12" Width="350" MaxHeight="360"
                    Background="{DynamicResource BgSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="14,12"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.22"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="26" Height="26" MinWidth="26"
                                Click="OnCloseAutofillFlyoutClick" ToolTip="Tutup panel sandi" AutomationProperties.Name="Tutup panel sandi">
                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="11" Height="11"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconKey}"
                                  Stroke="{DynamicResource AccentBrush}" Width="15" Height="15" Margin="0,0,7,0"/>
                            <TextBlock Text="Isi Otomatis Sandi" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="AutofillSiteSubtitle" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                    <!-- Matching Credentials List -->
                    <ItemsControl x:Name="AutofillMatchesList" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButtonStyle}"
                                        Click="OnAutofillMatchItemClick" Tag="{Binding}"
                                        HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,0,0,5"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="Isi →" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Origin}" FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty / Action State -->
                    <TextBlock x:Name="AutofillEmptyHint"
                               Text="Belum ada sandi tersimpan untuk situs ini pada profil aktif."
                               FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock x:Name="AutofillFeedbackText"
                               FontSize="12" Foreground="{DynamicResource WarningSoftTextBrush}"
                               TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="+ Tambah Sandi"
                                Click="OnAutofillAddCredentialClick" Padding="10,7" FontSize="12" Margin="0,0,4,0"/>
                        <Button Content="Impor CSV"
                                Click="OnAutofillImportCsvClick" Padding="10,7" FontSize="12" Margin="4,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Top-Right Non-Blocking Feedback Toast Pill -->
            <Border x:Name="ToastBanner"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,14,0"
                    Background="{DynamicResource BgSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,7"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="ToastText" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

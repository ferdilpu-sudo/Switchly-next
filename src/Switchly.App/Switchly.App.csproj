<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <RootNamespace>Switchly.App</RootNamespace>
    <AssemblyName>Switchly.App</AssemblyName>
    <Product>Switchly</Product>
    <Version>0.9.0-beta.1</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <Description>Switchly — Multi-account Windows desktop browser workspace</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Switchly.Application\Switchly.Application.csproj" />
    <ProjectReference Include="..\Switchly.BrowserHost\Switchly.BrowserHost.csproj" />
    <ProjectReference Include="..\Switchly.Infrastructure\Switchly.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Optional proprietary-codec CEF binary overlay (D13): when third_party/cef-proprietary/win-x64/libcef.dll exists locally,
       overwrite stock NuGet CEF binaries after Build and Publish so H.264/MP4/AAC playback works in-app. -->
  <PropertyGroup>
    <ProprietaryCefDir>$(MSBuildThisFileDirectory)..\..\third_party\cef-proprietary\win-x64</ProprietaryCefDir>
  </PropertyGroup>

  <Target Name="ApplyProprietaryCefOverlayOnBuild"
          AfterTargets="Build"
          Condition="Exists('$(ProprietaryCefDir)\libcef.dll')">
    <ItemGroup>
      <_ProprietaryCefFiles Include="$(ProprietaryCefDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProprietaryCefFiles)"
          DestinationFolder="$(OutDir)"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="true" />
    <Message Importance="High" Text="[Switchly] Applied proprietary-codec CEF overlay to $(OutDir)" />
  </Target>

  <Target Name="ApplyProprietaryCefOverlayOnPublish"
          AfterTargets="Publish"
          Condition="Exists('$(ProprietaryCefDir)\libcef.dll')">
    <ItemGroup>
      <_ProprietaryCefPublishFiles Include="$(ProprietaryCefDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProprietaryCefPublishFiles)"
          DestinationFolder="$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="true" />
    <Message Importance="High" Text="[Switchly] Applied proprietary-codec CEF overlay to $(PublishDir)" />
  </Target>

</Project>

<Window x:Class="Switchly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switchly Next"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="6">
            <Button DockPanel.Dock="Right" Content="Go" Command="{Binding NavigateCommand}" Padding="16,4" Margin="6,0,0,0"/>
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4,2"/>
        </DockPanel>
        <ContentControl x:Name="BrowserContainer"/>
    </DockPanel>
</Window>

<Window x:Class="Switchly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Switchly.App.Themes"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Switchly — Workspace"
        Height="820" Width="1340"
        MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Clean Profile & Folder Group Sidebar -->
        <Border x:Name="SidebarPanel" Grid.Column="0" Background="{DynamicResource BgSidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="12,14,12,10">
            <DockPanel>
                <!-- Top Brand Header (Calm & Focused — Theme Moved to Settings Hub) -->
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Switchly" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,2"
                                Margin="7,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreReleaseBuild}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="BETA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Always-Accessible Sidebar Quick-Search -->
                <TextBox x:Name="SidebarSearchBox" DockPanel.Dock="Top"
                         Style="{StaticResource PillTextBoxStyle}"
                         themes:TextBoxAssist.PlaceholderText="Cari profil..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Cari cepat profil"
                         Margin="0,0,0,10"/>

                <!-- Compact Segmented Nav Bar (Semua | Favorit | Arsip) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BgAppBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="3" Margin="0,0,0,12">
                    <UniformGrid Columns="3">
                        <Button x:Name="AllProfilesNavButton" Style="{StaticResource NavButtonActiveStyle}"
                                Content="Profil" HorizontalContentAlignment="Center" Padding="6,5" FontSize="12"
                                Click="OnAllProfilesClick"/>
                        <Button x:Name="FavoritesNavButton" Style="{StaticResource NavButtonStyle}"
                                Content="Favorit" HorizontalContentAlignment="Center" Padding="6,5" FontSize="12"
                                Click="OnFavoritesClick"/>
                        <Button x:Name="ArchivedNavButton" Style="{StaticResource NavButtonStyle}"
                                Content="Arsip" HorizontalContentAlignment="Center" Padding="6,5" FontSize="12"
                                Click="OnArchivedClick"/>
                    </UniformGrid>
                </Border>

                <!-- Clean 2-Item Global Utility Footer (Aktivitas & Pengaturan — Zero Duplicate Nav) -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Separator DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                        <Button x:Name="SidebarActivityButton" Style="{StaticResource GhostButtonStyle}" Click="OnOpenActivityViewClick"
                                Padding="8,7" Margin="0,0,3,0"
                                ToolTip="Pantau sesi profil yang sedang berjalan dan penggunaan RAM">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconActivity}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Aktivitas" FontSize="12.5" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SidebarSettingsButton" Style="{StaticResource GhostButtonStyle}" Click="OnOpenSettingsViewClick"
                                Padding="8,7" Margin="3,0,0,0"
                                ToolTip="Pengaturan tampilan, keamanan, sandi, cadangan, impor, dan akun">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconSettings}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Pengaturan" FontSize="12.5" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </DockPanel>

                <!-- Independent Scroll Sections: PROFIL (Top, Elastic) + GRUP (Pinned Bottom, Zero Empty Gap When Collapsed) -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="SidebarProfilesRow" Height="*"/>
                        <RowDefinition x:Name="SidebarGroupsRow" Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section 1: PROFIL -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                    Click="OnNewProfileClick" Padding="5,3"
                                    ToolTip="Buat profil baru" AutomationProperties.Name="Buat profil baru">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                      Stroke="{DynamicResource TextSecondaryBrush}" Width="13" Height="13"/>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Click="OnToggleSidebarProfilesSectionClick"
                                    HorizontalAlignment="Left" Padding="4,3"
                                    ToolTip="Ciutkan / tampilkan daftar profil">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="SidebarProfilesChevron" Style="{StaticResource VectorIconStyle}"
                                          Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource TextMutedBrush}"
                                          Width="11" Height="11" Margin="0,0,5,0"/>
                                    <TextBlock Text="PROFIL" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <ScrollViewer x:Name="SidebarProfilesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleProfiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnOpenProfileClick" Tag="{Binding}" HorizontalContentAlignment="Stretch"
                                                Padding="8,7" Margin="0,0,0,3" Cursor="Hand">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Buka di Ruang Kerja" Click="OnOpenProfileClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Buka di Jendela Baru" Click="OnOpenNewWindowClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Tutup Sesi" Click="OnCloseSessionClick" Tag="{Binding}" IsEnabled="{Binding IsActive}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Ubah Profil &amp; Atur Grup" Click="OnEditProfileClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Favorit / Hapus Favorit" Click="OnToggleFavoriteClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Duplikat Konfigurasi (Tanpa Sesi)" Click="OnDuplicateProfileClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Impor dari Chrome/Edge..." Click="OnImportForProfileClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Arsipkan / Pulihkan" Click="OnToggleArchiveClick" Tag="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Hapus Profil" Click="OnDeleteProfileClick" Tag="{Binding}"
                                                              Foreground="{DynamicResource DangerSoftTextBrush}" FontWeight="SemiBold"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentlyDocked}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8"
                                                        Background="{Binding ColorHex}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontSize="12.5" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Button DockPanel.Dock="Right" Click="OnCloseSessionClick" Tag="{Binding}"
                                                        Width="26" Height="26" Padding="6" Margin="4,0,0,0"
                                                        ToolTip="Tutup sesi profil ini untuk menghemat RAM"
                                                        AutomationProperties.Name="Tutup sesi profil">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="10" Height="10"/>
                                                </Button>
                                                <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{Binding StatusColor}"
                                                         VerticalAlignment="Center" Margin="6,0,2,0"
                                                         ToolTip="Sesi browser sedang berjalan">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               FontSize="13" FontWeight="SemiBold" LineHeight="18"/>
                                                    <TextBlock Text="{Binding GroupBadgeLabel}" TextTrimming="CharacterEllipsis"
                                                               FontSize="12" LineHeight="16" Padding="0,0,0,1"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Section 2: GRUP (Filter — Pinned & Keyboard-Accessible) -->
                    <DockPanel Grid.Row="1">
                        <Separator DockPanel.Dock="Top" Margin="0,0,0,8"/>
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                    Click="OnCreateGroupClick" Padding="5,3"
                                    ToolTip="Buat grup baru"
                                    AutomationProperties.Name="Buat folder grup baru">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                      Stroke="{DynamicResource TextSecondaryBrush}" Width="13" Height="13"/>
                            </Button>
                            <Button Style="{StaticResource GhostButtonStyle}" Click="OnToggleSidebarGroupsSectionClick"
                                    HorizontalAlignment="Left" Padding="4,3"
                                    ToolTip="Ciutkan / tampilkan daftar grup">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="SidebarGroupsChevron" Style="{StaticResource VectorIconStyle}"
                                          Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource TextMutedBrush}"
                                          Width="11" Height="11" Margin="0,0,5,0"/>
                                    <TextBlock Text="GRUP" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <ScrollViewer x:Name="SidebarGroupsBody" MaxHeight="180"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Belum ada grup. Buat grup (mis. Kerja, Pribadi) lalu pilih di menu Ubah Profil."
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                           Margin="4,0,4,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasManualGroups}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding ManualGroupItems}" Margin="0,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="OnCategoryChipClick" Tag="{Binding}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="8,6,6,6" Margin="0,0,0,4" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Buka Grup Ini" Click="OnCategoryChipClick" Tag="{Binding}"/>
                                                        <MenuItem Header="Ubah Grup &amp; URL..." Click="OnRenameManualGroupClick" Tag="{Binding}"/>
                                                        <MenuItem Header="Tutup Semua Sesi Grup Ini" Click="OnCloseGroupSessionsClick" Tag="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Hapus Grup" Click="OnDeleteManualGroupClick" Tag="{Binding}"
                                                                  Foreground="{DynamicResource DangerSoftTextBrush}" FontWeight="SemiBold"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <DockPanel>
                                                    <!-- Right: Member Count Pill + More Menu -->
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                        <Border Background="{DynamicResource BgAppBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                BorderThickness="1" CornerRadius="9" Padding="6,1" Margin="0,0,4,0" VerticalAlignment="Center"
                                                                ToolTip="Jumlah profil di grup ini">
                                                            <TextBlock Text="{Binding MemberCount}" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                                Click="OnGroupChipMoreClick" Tag="{Binding}"
                                                                Width="26" Height="26" Padding="5"
                                                                ToolTip="Opsi grup (Ubah URL, Tutup Sesi, Hapus)"
                                                                AutomationProperties.Name="Opsi grup">
                                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconMoreHorizontal}" Width="12" Height="12"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Left: Website Favicon Thumbnail or Web Workspace (Globe) / Folder Icon Badge -->
                                                    <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7"
                                                            Margin="0,0,9,0" VerticalAlignment="Center" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource BgAppBrush}"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsWebWorkspace}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Image Source="{Binding Favicon}" Width="18" Height="18"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Data" Value="{StaticResource IconFolder}"/>
                                                                        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsWebWorkspace}" Value="True">
                                                                                <Setter Property="Data" Value="{StaticResource IconGlobe}"/>
                                                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Center: Group Name + Domain Subtitle -->
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" LineHeight="18"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DomainSubtitle}" FontSize="12" LineHeight="16" Padding="0,0,0,1"
                                                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Main Right Area -->
        <DockPanel Grid.Column="1" Background="{DynamicResource BgAppBrush}">
            <!-- Browser-First Top Profile Strip (D14): Collapsible Sidebar Toggle + Running Profile Chips + Ctrl+Shift+K Switcher -->
            <Border x:Name="TopProfileStripBar" DockPanel.Dock="Top"
                    Background="{DynamicResource BgSidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    Padding="10,6">
                <DockPanel>
                    <!-- Left: Sidebar Collapse Toggle + Daftar Profil Button -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="SidebarToggleButton" Style="{StaticResource IconButtonStyle}"
                                Click="OnToggleSidebarClick" Width="30" Height="30" MinWidth="30" Margin="0,0,4,0"
                                ToolTip="Ciutkan / Tampilkan Sidebar (Ctrl+B)"
                                AutomationProperties.Name="Ciutkan atau tampilkan sidebar">
                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconSidebar}" Width="15" Height="15"/>
                        </Button>
                        <Button x:Name="TopProfilesButton" Style="{StaticResource GhostButtonStyle}"
                                Click="OnAllProfilesClick" Padding="9,5" FontSize="12" Margin="0,0,2,0"
                                Visibility="Collapsed"
                                ToolTip="Buka Daftar Profil (Profile Library)">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconGrid}" Width="13" Height="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Profil" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="TopActivityButton" Style="{StaticResource GhostButtonStyle}"
                                Click="OnOpenActivityViewClick" Padding="9,5" FontSize="12"
                                Visibility="Collapsed"
                                ToolTip="Buka Aktivitas &amp; Sesi Berjalan">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconActivity}" Width="13" Height="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Aktivitas" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="18" Background="{DynamicResource BorderSubtleBrush}" Margin="8,0,2,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Profile Switcher Command Palette Button (Ctrl+Shift+K) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Style="{StaticResource GhostButtonStyle}" Click="OnOpenProfileSwitcherClick"
                                Padding="10,5" FontSize="12"
                                ToolTip="Buka Pindah Profil Cepat (Ctrl+Shift+K)"
                                AutomationProperties.Name="Pindah Profil Cepat">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconSwitch}" Width="13" Height="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Pindah Profil" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <Border Background="{DynamicResource BgAppBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+Shift+K" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Center: Compact Horizontal Running Profile / Web-Space Chips (D10, D11, D14) -->
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="Belum ada sesi berjalan — pilih profil atau tekan Ctrl+Shift+K"
                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveWorkspaces}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ActiveWorkspaces}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Margin="0,0,6,0" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Click="OnActiveWorkspaceClick" Tag="{Binding}"
                                                        Padding="8,4,4,4" FontSize="12"
                                                        ToolTip="Klik untuk beralih ke sesi ini">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="18" Height="18" CornerRadius="5" Background="{Binding ColorHex}"
                                                                Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontWeight="Bold"
                                                                       FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayTitle}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" FontWeight="Medium"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Click="OnCloseActiveWorkspaceClick" Tag="{Binding}"
                                                        Width="26" Height="26" Padding="6" Margin="0,0,2,0"
                                                        ToolTip="Tutup sesi ini" AutomationProperties.Name="Tutup sesi">
                                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="9" Height="9"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Non-Obstructive Top Memory Advisory Strip (D15: never covers web page buttons like SeaArt Generate) -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource WarningSoftBgBrush}"
                    BorderBrush="{DynamicResource WarningSoftBorderBrush}"
                    BorderThickness="0,0,0,1" Padding="14,7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMemoryWarning}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                            Click="OnDismissMemoryWarningClick" Width="28" Height="28" Padding="6" Margin="8,0,0,0"
                            ToolTip="Tutup peringatan sementara" AutomationProperties.Name="Tutup peringatan memori">
                        <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}"
                              Stroke="{DynamicResource WarningSoftTextBrush}" Width="11" Height="11"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="Tutup Sesi Lain"
                            Click="OnCloseBackgroundSessionsClick" Padding="10,4" FontSize="12" Margin="10,0,0,0"
                            ToolTip="Matikan sesi profil latar belakang untuk menghemat RAM">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBackgroundSessions}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button DockPanel.Dock="Right" Content="Tutup Sesi Ini"
                            Click="OnCloseAllSessionsClick" Padding="10,4" FontSize="12" Margin="10,0,0,0"
                            ToolTip="Tutup sesi aktif saat ini untuk melepaskan RAM">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSingleActiveSession}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding MemoryWarningMessage}" Foreground="{DynamicResource WarningSoftTextBrush}"
                               FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Calm 3-Zone Footer Status Bar (No Unguarded Destructive Buttons — Heuristic #2 & #5) -->
            <Border x:Name="FooterStatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource BgSidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="18,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Zone: Profile Counts + Safe Background Sleep -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FooterProfileSummary}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Tutup Sesi Lain" Click="OnCloseBackgroundSessionsClick"
                                Padding="8,3" FontSize="12"
                                ToolTip="Tutup semua sesi di latar belakang kecuali profil yang sedang Anda lihat">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBackgroundSessions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Center Zone: Compact RAM Telemetry -->
                    <TextBlock Grid.Column="1" Text="{Binding FooterRamSummary}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <!-- Right Zone: Tidur Otomatis Toggle + Version -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}" Content="{Binding AutoSleepLabel}"
                                Click="OnToggleAutoSleepClick" Padding="8,3" FontSize="12" Margin="0,0,10,0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                ToolTip="Tidurkan otomatis profil latar belakang yang tidak dipakai selama 30 menit"/>
                        <TextBlock Text="{Binding AppVersionDisplay}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <!-- Mode A: Profile & Folder Group Dashboard -->
                <DockPanel x:Name="DashboardView">
                    <!-- Clean Header with Strong 24px Visual Hierarchy -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgSurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,18">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                     Click="OnNewProfileClick" Padding="16,9">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                          Stroke="White" Width="14" Height="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="Profil Baru" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SectionTitle}" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SectionSubtitle}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource DangerSoftBgBrush}"
                            BorderBrush="{DynamicResource DangerSoftBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerSoftTextBrush}"
                                   FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Profile Library Control Bar: Status Filter + Count + Sorting -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgAppBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,10">
                        <DockPanel>
                            <!-- Right: Stable Sorting Selector -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Urutkan:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="SortOrderCombo" Width="170" SelectedIndex="0"
                                          SelectionChanged="OnSortOrderSelectionChanged"
                                          AutomationProperties.Name="Urutkan daftar profil">
                                    <ComboBoxItem Content="Nama (A – Z)" Tag="NameAsc"/>
                                    <ComboBoxItem Content="Status Berjalan Dulu" Tag="StatusActiveFirst"/>
                                    <ComboBoxItem Content="Terakhir Dibuka" Tag="RecentlyUsed"/>
                                    <ComboBoxItem Content="Terbaru Dibuat" Tag="NewestCreated"/>
                                    <ComboBoxItem Content="Grup (A – Z)" Tag="GroupAsc"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Left: Status Filter Segmented Pills + Live Count -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BgSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="2" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="StatusAllButton" Style="{StaticResource NavButtonActiveStyle}"
                                                Content="Semua" Click="OnStatusFilterAllClick" Padding="10,4" FontSize="12"/>
                                        <Button x:Name="StatusRunningButton" Style="{StaticResource NavButtonStyle}"
                                                Content="Berjalan" Click="OnStatusFilterRunningClick" Padding="10,4" FontSize="12"/>
                                        <Button x:Name="StatusInactiveButton" Style="{StaticResource NavButtonStyle}"
                                                Content="Tertutup" Click="OnStatusFilterInactiveClick" Padding="10,4" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding VisibleProfileCountLabel}" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Contextual Safe Bulk Actions Bar (appears only when >= 1 profile checked) -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Padding="24,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedProfiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Tutup Sesi"
                                        Click="OnBulkCloseSessionsClick" Padding="10,4" FontSize="12" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Arsipkan / Pulihkan"
                                        Click="OnBulkArchiveClick" Padding="10,4" FontSize="12" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DangerOutlineButtonStyle}" Content="Hapus Terpilih"
                                        Click="OnBulkDeleteClick" Padding="10,4" FontSize="12" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Batal Pilih"
                                        Click="OnBulkClearSelectionClick" Padding="8,4" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectionSummary}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Empty State + Calm Virtualized Profile Library Table -->
                    <Grid Margin="24,14,24,16">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"
                                     HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconGrid}"
                                      Stroke="{DynamicResource AccentBrush}" Width="24" Height="24"/>
                            </Border>
                            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding EmptyStateDescription}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                       TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnNewProfileClick"
                                    Padding="18,9" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                          Stroke="White" Width="14" Height="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding EmptyStatePrimaryButtonLabel}" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border VerticalAlignment="Top" CornerRadius="12" Background="{DynamicResource BgSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <!-- Sticky Table Header -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource BgSidebarBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                        CornerRadius="12,12,0,0" Padding="14,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="136"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="126"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SelectAllProfilesCheckBox" Grid.Column="0" VerticalAlignment="Center"
                                                  Click="OnSelectAllProfilesClick"
                                                  ToolTip="Pilih semua profil yang tampil"
                                                  AutomationProperties.Name="Pilih semua profil"/>
                                        <TextBlock Grid.Column="1" Text="PROFIL" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="GRUP" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="STATUS" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="TERAKHIR DIBUKA" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="AKSI" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                    </Grid>
                                </Border>

                                <!-- Virtualized Recycling ListBox -->
                                <ListBox x:Name="ProfileLibraryList"
                                         ItemsSource="{Binding VisibleProfiles}"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RowSurface" Padding="14,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                                    Cursor="Hand" MouseLeftButtonUp="OnProfileCardClick" Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Buka di Ruang Kerja" Click="OnOpenProfileClick" Tag="{Binding}"/>
                                                        <MenuItem Header="Buka di Jendela Baru" Click="OnOpenNewWindowClick" Tag="{Binding}"/>
                                                        <MenuItem Header="Tutup Sesi" Click="OnCloseSessionClick" Tag="{Binding}" IsEnabled="{Binding IsActive}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Ubah Profil &amp; Atur Grup" Click="OnEditProfileClick" Tag="{Binding}"/>
                                                        <MenuItem Header="Favorit / Hapus Favorit" Click="OnToggleFavoriteClick" Tag="{Binding}"/>
                                                        <MenuItem Header="Duplikat Konfigurasi (Tanpa Sesi)" Click="OnDuplicateProfileClick" Tag="{Binding}"/>
                                                        <MenuItem Header="Impor dari Chrome/Edge..." Click="OnImportForProfileClick" Tag="{Binding}"/>
                                                        <MenuItem Header="Arsipkan / Pulihkan" Click="OnToggleArchiveClick" Tag="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Hapus Profil" Click="OnDeleteProfileClick" Tag="{Binding}"
                                                                  Foreground="{DynamicResource DangerSoftTextBrush}" FontWeight="SemiBold"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                                        <ColumnDefinition Width="136"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="126"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Col 0: Bulk Selection Checkbox -->
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Click="OnRowSelectionCheckboxClick" VerticalAlignment="Center"
                                                              AutomationProperties.Name="Pilih profil"/>

                                                    <!-- Col 1: Colored Avatar + Profile Name + Startup URL -->
                                                    <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8"
                                                                Background="{Binding ColorHex}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontSize="14" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" LineHeight="19"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding StartupUrlDisplay}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       FontSize="12" LineHeight="17" Padding="0,0,0,1" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Col 2: Group Badge (+N format, full list in ToolTip) -->
                                                    <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{DynamicResource BgAppBrush}"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3" Margin="0,0,8,0"
                                                            ToolTip="{Binding FullGroupTooltip}">
                                                        <TextBlock Text="{Binding GroupBadgeLabel}" FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </Border>

                                                    <!-- Col 3: Status Pill (Tampil / Berjalan / Tertutup) -->
                                                    <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{DynamicResource BgAppBrush}"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                            CornerRadius="10" Padding="8,3">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Col 4: Last Opened -->
                                                    <TextBlock Grid.Column="4" Text="{Binding LastUsedDisplay}" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Col 5: Calm Actions (Star shown when favorited or hovered + Buka + ⋯ Menu, >= 30px WCAG 2.5.8) -->
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Width="30" Height="30" MinWidth="30" Margin="0,0,4,0"
                                                                Click="OnToggleFavoriteClick" Tag="{Binding}"
                                                                ToolTip="Tandai / hapus favorit" AutomationProperties.Name="Tandai atau hapus favorit">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                                    <Setter Property="Opacity" Value="0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=RowSurface}" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Path Data="{StaticResource IconStar}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
                                                                        <Setter Property="Fill" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                <Setter Property="Stroke" Value="{DynamicResource FavoriteBrush}"/>
                                                                                <Setter Property="Fill" Value="{DynamicResource FavoriteBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Button>
                                                        <Button Content="Buka"
                                                                Click="OnOpenProfileClick" Tag="{Binding}"
                                                                Padding="12,4" MinHeight="30" FontSize="12" Margin="0,0,4,0"
                                                                Background="{DynamicResource BgAppBrush}"
                                                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                                                                Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" MinWidth="30"
                                                                Click="OnCardMoreClick" Tag="{Binding}"
                                                                ToolTip="Opsi lainnya (Jendela Baru, Ubah, Duplikat, Arsip, Hapus)"
                                                                AutomationProperties.Name="Opsi lainnya">
                                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconMoreHorizontal}" Width="14" Height="14"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- Mode B: Active Docked Browser Workspace -->
                <ContentControl x:Name="DockedBrowserHost" Visibility="Collapsed"/>

                <!-- Mode C: Dedicated Activity & Running Sessions View -->
                <DockPanel x:Name="ActivityView" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgSurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,18">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Tutup Sesi Lain"
                                        Click="OnCloseBackgroundSessionsClick" Padding="12,7" Margin="0,0,8,0"
                                        IsEnabled="{Binding HasBackgroundSessions}"/>
                                <Button Style="{StaticResource DangerOutlineButtonStyle}" Content="Tutup Semua Sesi"
                                        Click="OnCloseAllSessionsClick" Padding="12,7"
                                        IsEnabled="{Binding HasActiveSessions}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Aktivitas &amp; Sesi Berjalan" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Pantau semua sesi browser yang sedang aktif, fokuskan ruang kerja, atau tutup sesi latar belakang untuk menghemat RAM."
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Live Resource Summary Cards -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgAppBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,12">
                        <UniformGrid Columns="3">
                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="RINGKASAN PROFIL" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding FooterProfileSummary}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="PENGGUNAAN MEMORI" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding FooterRamSummary}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="TIDUR OTOMATIS" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AutoSleepLabel}" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <!-- Active Sessions List / Empty State -->
                    <Grid Margin="24,16">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveWorkspaces}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconActivity}"
                                      Stroke="{DynamicResource AccentBrush}" Width="24" Height="24"/>
                            </Border>
                            <TextBlock Text="Tidak ada sesi browser yang sedang berjalan." FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Profil tersimpan tidak menjalankan proses browser sampai Anda membukanya. RAM tetap bersih dan ringan."
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="Buka Daftar Profil"
                                    Click="OnAllProfilesClick" Padding="18,9" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveWorkspaces}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding ActiveWorkspaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgSurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource BgAppBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                                                            <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Berjalan"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                                <Setter Property="Text" Value="Tampil"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsPopOut}" Value="True">
                                                                                <Setter Property="Text" Value="Jendela Baru"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <Button Style="{StaticResource GhostButtonStyle}" Content="Fokuskan"
                                                            Click="OnActiveWorkspaceClick" Tag="{Binding}"
                                                            Padding="12,5" FontSize="12" Margin="0,0,6,0"
                                                            Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                    <Button Style="{StaticResource DangerOutlineButtonStyle}" Content="Tutup Sesi"
                                                            Click="OnCloseActiveWorkspaceClick" Tag="{Binding}"
                                                            Padding="10,5" FontSize="12"/>
                                                </StackPanel>

                                                <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="9"
                                                        Background="{Binding ColorHex}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontSize="15" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- Mode D: Structured 2-Column Settings Hub (Left Sub-Nav + Single Primary CTA per Section — Heuristics #5, #6, #8) -->
                <DockPanel x:Name="SettingsView" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgSurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,18">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pengaturan Switchly" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Atur tampilan, keamanan lokal, cadangan, impor, lisensi, dan pintasan aplikasi."
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Settings Left Sub-Navigation -->
                        <StackPanel Grid.Column="0">
                            <Button x:Name="SettingsNavGeneralButton" Style="{StaticResource NavButtonActiveStyle}"
                                    Content="Umum &amp; Tampilan" Tag="General" Click="OnSettingsSubNavClick"
                                    HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,4"/>
                            <Button x:Name="SettingsNavSecurityButton" Style="{StaticResource GhostButtonStyle}"
                                    Content="Keamanan &amp; Sandi" Tag="Security" Click="OnSettingsSubNavClick"
                                    HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,4"/>
                            <Button x:Name="SettingsNavDataButton" Style="{StaticResource GhostButtonStyle}"
                                    Content="Cadangan &amp; Impor" Tag="Data" Click="OnSettingsSubNavClick"
                                    HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,4"/>
                            <Button x:Name="SettingsNavAccountButton" Style="{StaticResource GhostButtonStyle}"
                                    Content="Akun &amp; Lisensi" Tag="Account" Click="OnSettingsSubNavClick"
                                    HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,4"/>
                            <Button x:Name="SettingsNavAboutButton" Style="{StaticResource GhostButtonStyle}"
                                    Content="Pintasan &amp; Tentang" Tag="About" Click="OnSettingsSubNavClick"
                                    HorizontalContentAlignment="Left" Padding="12,9"/>
                        </StackPanel>

                        <!-- Settings Right Content Panels -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="680" HorizontalAlignment="Left">

                                <!-- Sub-Page 1: General & Appearance -->
                                <StackPanel x:Name="SettingsPanelGeneral">
                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="SettingsLightThemeButton" Style="{StaticResource NavButtonActiveStyle}"
                                                        Content="Terang" Click="OnSelectLightThemeClick" Padding="14,6" Margin="0,0,6,0"/>
                                                <Button x:Name="SettingsDarkThemeButton" Style="{StaticResource NavButtonStyle}"
                                                        Content="Gelap" Click="OnSelectDarkThemeClick" Padding="14,6"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Tema Antarmuka" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Pilih mode Terang atau Gelap dengan palet kontras teruji. Preferensi tersimpan lokal."
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{Binding AutoSleepLabel}"
                                                    Click="OnToggleAutoSleepClick" Padding="14,7" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Tidur Otomatis Hemat RAM" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Menutup sesi profil latar belakang yang tidak disentuh selama 30 menit tanpa mengganggu profil yang sedang tampil atau dibuka di jendela baru."
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Sub-Page 2: Security & Password Vault (1 Primary CTA) -->
                                <StackPanel x:Name="SettingsPanelSecurity" Visibility="Collapsed">
                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="Kelola Password Vault" Click="OnOpenVaultDialogClick"
                                                    Padding="14,8" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Password Vault Terisolasi" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Simpan atau impor CSV sandi per profil dengan enkripsi AES-256-GCM + Windows DPAPI tanpa sinkronisasi cloud."
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Atur Kunci Aplikasi"
                                                    Click="OnSecurityAndBackupClick" Padding="14,8" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Kunci Kata Sandi Utama" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Tambahkan layar pengunci saat Switchly dibuka agar orang lain yang meminjam PC ini tidak bisa mengakses sesi Anda."
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Sub-Page 3: Backup & Browser Import (1 Primary CTA) -->
                                <StackPanel x:Name="SettingsPanelData" Visibility="Collapsed">
                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="Buat / Pulihkan Cadangan" Click="OnOpenBackupDialogClick"
                                                    Padding="14,8" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Cadangan Terenkripsi (.snbak)" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Ekspor profil, grup, dan Password Vault ke arsip terenkripsi AES-256-GCM untuk dicadangkan atau dipindah ke PC baru."
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Impor dari Chrome / Edge"
                                                    Click="OnImportBrowserClick" Padding="14,8" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Impor Bookmark &amp; Riwayat" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="Impor bookmark, riwayat kunjungan, atau alamat tab terbuka secara baca-saja tanpa menyentuh browser asal."
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Sub-Page 4: Account & Licensing (1 Primary CTA) -->
                                <StackPanel x:Name="SettingsPanelAccount" Visibility="Collapsed">
                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="Kelola Akun &amp; Lisensi" Click="OnManageLicenseClick"
                                                    Padding="14,8" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Status Paket" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                                                            BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="SettingsLicenseBadgeText" Text="Free Beta" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="Mode Free (maks. 5 profil) berjalan 100% lokal tanpa login. Masuk dengan email OTP untuk Trial Pro 7 hari gratis atau upgrade Pro (QRIS / Virtual Account)."
                                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Sub-Page 5: Keyboard Shortcuts & Privacy/About -->
                                <StackPanel x:Name="SettingsPanelAbout" Visibility="Collapsed">
                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="Pintasan Keyboard" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                            <TextBlock Text="• Pindah Profil Cepat:  Ctrl + Shift + K" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                            <TextBlock Text="• Ciutkan / Tampilkan Sidebar:  Ctrl + B" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                            <TextBlock Text="• Tab Baru / Tutup Tab / Pulihkan Tab:  Ctrl + T  /  Ctrl + W  /  Ctrl + Shift + T" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                            <TextBlock Text="• Pindah Tab Maju / Mundur:  Ctrl + Tab  /  Ctrl + Shift + Tab" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                            <TextBlock Text="• Fokus Kolom URL / Cari di Halaman:  Ctrl + L  /  Ctrl + F" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="18,16">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                                <Image Source="pack://application:,,,/Assets/logo.png" Width="30" Height="30"
                                                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Privasi &amp; Tentang Switchly" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AboutVersionLine}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Mesin Browser: Chromium 156 (isolasi cookie &amp; penyimpanan penuh per profil)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Telemetri: NONAKTIF (Local-first, log diagnostik lokal dengan redaksi rahasia)" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

            </Grid>
        </DockPanel>

        <!-- Profile Switcher / Command Palette Overlay (Ctrl+Shift+K, D14) -->
        <Grid x:Name="ProfileSwitcherOverlay" Grid.ColumnSpan="2"
              Background="#66000000" Visibility="Collapsed"
              MouseDown="OnProfileSwitcherBackdropMouseDown">
            <Border MaxWidth="540" MinWidth="420" MaxHeight="480" VerticalAlignment="Top" Margin="24,48,24,24"
                    Background="{DynamicResource BgSurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="0"
                    MouseDown="OnProfileSwitcherCardMouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.28"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Search Header -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1" Padding="14,12">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource BgAppBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="ESC" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                            <Path DockPanel.Dock="Left" Style="{StaticResource VectorIconStyle}"
                                  Data="{StaticResource IconSearch}" Width="16" Height="16"
                                  Stroke="{DynamicResource TextMutedBrush}" Margin="2,0,10,0"/>
                            <TextBox x:Name="SwitcherSearchBox"
                                     Style="{StaticResource BorderlessTextBoxStyle}"
                                     FontSize="14"
                                     themes:TextBoxAssist.PlaceholderText="Pindah profil cepat — ketik nama profil, grup, atau URL..."
                                     TextChanged="OnSwitcherSearchTextChanged"
                                     PreviewKeyDown="OnSwitcherSearchPreviewKeyDown"
                                     AutomationProperties.Name="Cari profil untuk berpindah cepat"/>
                        </DockPanel>
                    </Border>

                    <!-- Palette Footer Actions -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgSidebarBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,12,12" Padding="12,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButtonStyle}" Content="Semua Profil"
                                        Click="OnSwitcherBrowseAllClick" Padding="10,4" FontSize="12" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}" Content="+ Profil Baru"
                                        Click="OnSwitcherNewProfileClick" Padding="12,4" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="↑↓ pilih  •  Enter buka/fokus  •  Esc tutup"
                                       FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Ranked Profile Results -->
                    <ListBox x:Name="SwitcherResultsList" BorderThickness="0" Background="Transparent"
                             Padding="6" MaxHeight="360"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnSwitcherResultActivate"
                             PreviewKeyDown="OnSwitcherListPreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel MouseLeftButtonUp="OnSwitcherRowClick" Tag="{Binding}">
                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="8"
                                            Background="{Binding ColorHex}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontWeight="Bold"
                                                   FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <Border DockPanel.Dock="Right" Background="{DynamicResource BgAppBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusColor}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding GroupBadgeLabel, Mode=OneWay}"/>
                                            <Run Text="  •  "/>
                                            <Run Text="{Binding DomainLabel, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

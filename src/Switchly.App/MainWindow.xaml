<Window x:Class="Switchly.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:Switchly.App.Themes"
        Style="{StaticResource ThemedWindowStyle}"
        Title="Switchly — Workspace"
        Height="820" Width="1340"
        MinHeight="580" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Clean Profile & Folder Group Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="12,14,12,10">
            <DockPanel>
                <!-- Top Brand Header + Theme Toggle -->
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,12">
                    <Button x:Name="ThemeToggleButton" DockPanel.Dock="Right"
                            Style="{StaticResource IconButtonStyle}"
                            Click="OnToggleThemeClick"
                            ToolTip="Ganti tema Gelap / Terang"
                            AutomationProperties.Name="Ganti tema Gelap atau Terang">
                        <Path x:Name="ThemeIconPath" Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconSun}"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0">
                            <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Switchly" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="6,2"
                                Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Always-Accessible Sidebar Quick-Search (Ctrl+K) -->
                <TextBox x:Name="SidebarSearchBox" DockPanel.Dock="Top"
                         Style="{StaticResource PillTextBoxStyle}"
                         themes:TextBoxAssist.PlaceholderText="Cari profil (Ctrl+K)..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Cari cepat profil"
                         Margin="0,0,0,10"/>

                <!-- Compact Segmented Nav Bar (Semua | Favorit | Arsip) -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource BgAppBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="9" Padding="3" Margin="0,0,0,12">
                    <UniformGrid Columns="3">
                        <Button x:Name="AllProfilesNavButton" Style="{StaticResource NavButtonActiveStyle}"
                                Content="Semua" HorizontalContentAlignment="Center" Padding="6,5" FontSize="12"
                                Click="OnAllProfilesClick"/>
                        <Button x:Name="FavoritesNavButton" Style="{StaticResource NavButtonStyle}"
                                Content="Favorit" HorizontalContentAlignment="Center" Padding="6,5" FontSize="12"
                                Click="OnFavoritesClick"/>
                        <Button x:Name="ArchivedNavButton" Style="{StaticResource NavButtonStyle}"
                                Content="Arsip" HorizontalContentAlignment="Center" Padding="6,5" FontSize="12"
                                Click="OnArchivedClick"/>
                    </UniformGrid>
                </Border>

                <!-- Compact 1-Row Global Utility Footer -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Separator DockPanel.Dock="Top" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource GhostButtonStyle}" Click="OnImportBrowserClick"
                                Padding="8,7" Margin="0,0,3,0"
                                ToolTip="Impor bookmark, riwayat, atau tab terbuka dari Chrome/Edge">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconDownload}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Impor" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" Click="OnSecurityAndBackupClick"
                                Padding="8,7" Margin="3,0,0,0"
                                ToolTip="Kunci lokal DPAPI, Password Vault, dan Backup/Restore">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconShield}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Keamanan" FontSize="12" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </DockPanel>

                <!-- Unified Smooth Scroll Area: Active Tasks + Profiles + Folder Groups -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Live Active Workspaces / Tasks Switcher (Workspace • Profile) -->
                        <StackPanel Margin="0,0,0,14">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveWorkspaces}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="SEDANG AKTIF (TASK)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" Margin="4,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding ActiveWorkspaceGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding HeaderLabel}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Click="OnActiveWorkspaceClick" Tag="{Binding}" HorizontalContentAlignment="Stretch"
                                                                Padding="8,5" Margin="6,0,0,3" Cursor="Hand"
                                                                ToolTip="Klik untuk langsung pindah ke task aktif ini">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                                    <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                            <Setter Property="BorderThickness" Value="1.5"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="6"
                                                                        Background="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                                                        Click="OnCloseActiveWorkspaceClick" Tag="{Binding}"
                                                                        Width="22" Height="22" Padding="5" Margin="4,0,0,0"
                                                                        ToolTip="Tutup task ini"
                                                                        AutomationProperties.Name="Tutup task">
                                                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="10" Height="10"/>
                                                                </Button>
                                                                <TextBlock Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" FontSize="12.5" FontWeight="Medium"/>
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Quick Profile Switcher with Active Highlight & Group Subtitle -->
                        <DockPanel Margin="4,0,2,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                    Click="OnNewProfileClick" Padding="6,2"
                                    ToolTip="Buat profil baru" AutomationProperties.Name="Buat profil baru">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                          Stroke="{DynamicResource AccentBrush}" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Baru" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="PROFIL (1 KLIK BUKA)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding VisibleProfiles}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnOpenProfileClick" Tag="{Binding}" HorizontalContentAlignment="Stretch"
                                            Padding="8,7" Margin="0,0,0,3" Cursor="Hand"
                                            ToolTip="Klik untuk buka / pindah ke profil ini">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentlyDocked}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="8"
                                                    Background="{Binding ColorHex}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontSize="12.5" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button DockPanel.Dock="Right" Click="OnCloseSessionClick" Tag="{Binding}"
                                                    Width="24" Height="24" Padding="5" Margin="4,0,0,0"
                                                    ToolTip="Tutup sesi profil ini untuk menghemat RAM"
                                                    AutomationProperties.Name="Tutup sesi profil">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="10" Height="10"/>
                                            </Button>
                                            <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{Binding StatusColor}"
                                                     VerticalAlignment="Center" Margin="6,0,2,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           FontSize="12.5" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding GroupBadgeLabel}" TextTrimming="CharacterEllipsis"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Folder Groups (Manual Groups Only — D9) -->
                        <DockPanel Margin="4,0,2,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}"
                                    Click="OnCreateGroupClick" Padding="6,2"
                                    ToolTip="Buat folder grup baru (mis. Kerja, Pribadi, Klien)"
                                    AutomationProperties.Name="Buat folder grup baru">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                          Stroke="{DynamicResource AccentBrush}" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Grup" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="GRUP / FOLDER" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Belum ada grup. Buat grup (mis. Kerja, Pribadi) lalu pilih di menu Ubah Profil."
                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                                   Margin="4,0,4,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasManualGroups}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding ManualGroups}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="13" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="{Binding Name}" Click="OnCategoryChipClick" Tag="{Binding}"
                                                    Padding="10,4,5,4" FontSize="12"
                                                    ToolTip="Tampilkan profil di dalam grup ini"/>
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Click="OnDeleteManualGroupClick" Tag="{Binding}"
                                                    Padding="4,4,8,4"
                                                    ToolTip="Hapus grup ini (profil di dalamnya tetap aman)"
                                                    AutomationProperties.Name="Hapus grup">
                                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconClose}" Width="9" Height="9"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Right Area -->
        <DockPanel Grid.Column="1" Background="{DynamicResource BgAppBrush}">
            <!-- Non-Modal Memory Pressure Warning Banner -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource WarningSoftBgBrush}"
                    BorderBrush="{DynamicResource WarningSoftBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMemoryWarning}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Tutup Sesi Latar Belakang"
                            Click="OnCloseBackgroundSessionsClick" Padding="10,4" FontSize="12" Margin="12,0,0,0"
                            ToolTip="Matikan semua sesi profil yang tidak sedang Anda buka untuk menghemat RAM"/>
                    <TextBlock Text="{Binding MemoryWarningMessage}" Foreground="{DynamicResource WarningSoftTextBrush}"
                               FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Quiet Footer Status Bar with 1-Click Session Cleanup & Auto-Sleep Toggle (D12) -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgSidebarBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="16,5">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}" Content="{Binding AutoSleepLabel}"
                                Click="OnToggleAutoSleepClick" Padding="8,3" FontSize="11.5" Margin="0,0,10,0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                ToolTip="Otomatis tidurkan profil latar belakang yang tidak dipakai selama 30 menit (klik untuk ON/OFF)"/>
                        <TextBlock Text="Switchly 0.9.0-beta.1" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResourceStatusText}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Tutup Sesi Lain" Click="OnCloseBackgroundSessionsClick"
                                Padding="8,3" FontSize="11.5" Margin="0,0,6,0"
                                ToolTip="Tutup semua sesi di latar belakang kecuali profil yang sedang Anda lihat">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBackgroundSessions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Tutup Semua" Click="OnCloseAllSessionsClick"
                                Padding="8,3" FontSize="11.5"
                                ToolTip="Matikan seluruh sesi profil yang sedang berjalan">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DangerSoftTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveSessions}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <!-- Mode A: Profile & Folder Group Dashboard -->
                <DockPanel x:Name="DashboardView">
                    <!-- Clean Header -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgSurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,16">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnNewProfileClick" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                          Stroke="White" Width="14" Height="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="Profil Baru" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Klik kartu profil untuk membuka browser terisolasi. Atur grup dari menu Ubah Profil."
                                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Clean 1-Click Folder Group Filter Bar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgAppBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="24,10">
                        <WrapPanel VerticalAlignment="Center">
                            <Button Style="{StaticResource ChipButtonStyle}" Content="Semua Profil"
                                    Click="OnAllProfilesClick" Margin="0,0,6,4"/>
                            <Button Style="{StaticResource ChipButtonStyle}" Content="Favorit"
                                    Click="OnFavoritesClick" Margin="0,0,8,4"/>

                            <ItemsControl ItemsSource="{Binding ManualGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipButtonStyle}" Content="{Binding Name}"
                                                Click="OnCategoryChipClick" Tag="{Binding}" Margin="0,0,6,4"
                                                ToolTip="Tampilkan profil dalam grup ini"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource GhostButtonStyle}" Click="OnCreateGroupClick"
                                    Padding="8,4" Margin="2,0,0,4" ToolTip="Buat folder grup baru">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                          Stroke="{DynamicResource AccentBrush}" Width="12" Height="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="Buat Grup" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource DangerSoftBgBrush}"
                            BorderBrush="{DynamicResource DangerSoftBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerSoftTextBrush}"
                                   FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Empty State + Responsive Clickable Profile Card Grid -->
                    <Grid Margin="24,18">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="54" Height="54" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconGrid}"
                                      Stroke="{DynamicResource AccentBrush}" Width="24" Height="24"/>
                            </Border>
                            <TextBlock Text="Belum ada profil di tampilan ini." FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Buat profil baru atau pindahkan profil ke grup ini lewat menu Ubah Profil."
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnNewProfileClick"
                                    Padding="18,9" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconPlus}"
                                          Stroke="White" Width="14" Height="14" Margin="0,0,7,0"/>
                                    <TextBlock Text="Buat Profil Baru" Foreground="White" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding VisibleProfiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="296" CornerRadius="12" Padding="15,14" Margin="0,0,14,14"
                                                BorderThickness="1" Background="{DynamicResource BgSurfaceBrush}"
                                                Cursor="Hand" MouseLeftButtonUp="OnProfileCardClick" Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="Background" Value="{DynamicResource BgSurfaceHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Buka di Workspace (Terintegrasi)" Click="OnOpenProfileClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Buka di Jendela Baru (Pop-out)" Click="OnOpenNewWindowClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Tutup Sesi" Click="OnCloseSessionClick" Tag="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Ubah Profil &amp; Atur Grup" Click="OnEditProfileClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Favorit / Hapus Favorit" Click="OnToggleFavoriteClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Duplikat Konfigurasi (Tanpa Sesi)" Click="OnDuplicateProfileClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Impor dari Chrome/Edge..." Click="OnImportForProfileClick" Tag="{Binding}"/>
                                                    <MenuItem Header="Arsipkan / Pulihkan" Click="OnToggleArchiveClick" Tag="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Hapus Profil" Click="OnDeleteProfileClick" Tag="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <!-- Card Header: Avatar + Name + Quick Icons -->
                                                <DockPanel Margin="0,0,0,12">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" MinWidth="30"
                                                                Click="OnToggleFavoriteClick" Tag="{Binding}"
                                                                ToolTip="Favorit" AutomationProperties.Name="Tandai atau hapus favorit">
                                                            <Path Data="{StaticResource IconStar}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}"/>
                                                                        <Setter Property="Fill" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                                <Setter Property="Stroke" Value="{DynamicResource FavoriteBrush}"/>
                                                                                <Setter Property="Fill" Value="{DynamicResource FavoriteBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" MinWidth="30"
                                                                Click="OnOpenNewWindowClick" Tag="{Binding}"
                                                                ToolTip="Buka di jendela terpisah (pop-out)" AutomationProperties.Name="Buka di jendela baru">
                                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconExternalLink}" Width="14" Height="14"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30" MinWidth="30"
                                                                Click="OnCardMoreClick" Tag="{Binding}"
                                                                ToolTip="Opsi lainnya" AutomationProperties.Name="Opsi lainnya">
                                                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource IconMoreHorizontal}" Width="14" Height="14"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10"
                                                            Background="{Binding ColorHex}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding InitialLetter}" Foreground="White" FontSize="16" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding StartupUrlDisplay}" Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Card Footer: Folder Group Pill + Runtime Status -->
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Background="{DynamicResource BgAppBrush}"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GroupBadgeLabel}" FontSize="11.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>

                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding StatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- Mode B: Active Docked Browser Workspace -->
                <ContentControl x:Name="DockedBrowserHost" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Quiet Precision Light Theme (Windows 11 Fluent x Notion inspired, WCAG AA verified) -->
    <SolidColorBrush x:Key="BgAppBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#F0F2F6"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgSurfaceHoverBrush" Color="#E6EAF1"/>
    <SolidColorBrush x:Key="BgSurfaceElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgTabStripBrush" Color="#E5E9F0"/>
    <SolidColorBrush x:Key="BgTabActiveBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgTabInactiveBrush" Color="#EEF1F6"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E6EE"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C8D0DF"/>

    <!-- WCAG AA >= 4.5:1 verified against BgAppBrush / BgSidebarBrush / BgSurfaceBrush -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#475569"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerSoftBgBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="DangerSoftTextBrush" Color="#B91C1C"/>

    <SolidColorBrush x:Key="WarningSoftBgBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="WarningSoftBorderBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningSoftTextBrush" Color="#92400E"/>

    <SolidColorBrush x:Key="InfoSoftBgBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="InfoSoftBorderBrush" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="InfoSoftTextBrush" Color="#1E40AF"/>

    <SolidColorBrush x:Key="SuccessTextBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="FavoriteBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#94A3B8"/>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Quiet Precision Dark Theme (Linear x Arc inspired, WCAG AA verified) -->
    <SolidColorBrush x:Key="BgAppBrush" Color="#0B0E14"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#0F131A"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#151A23"/>
    <SolidColorBrush x:Key="BgSurfaceHoverBrush" Color="#1C2330"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="#1C2330"/>
    <SolidColorBrush x:Key="BgSurfaceElevatedBrush" Color="#131822"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#0D1118"/>
    <SolidColorBrush x:Key="BgTabStripBrush" Color="#090C11"/>
    <SolidColorBrush x:Key="BgTabActiveBrush" Color="#151B26"/>
    <SolidColorBrush x:Key="BgTabInactiveBrush" Color="#0F131B"/>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1F2735"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#323E54"/>

    <!-- WCAG AA >= 4.5:1 verified against BgAppBrush / BgSidebarBrush / BgSurfaceBrush -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#172540"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBgBrush" Color="#2A1317"/>
    <SolidColorBrush x:Key="DangerSoftBorderBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="DangerSoftTextBrush" Color="#FCA5A5"/>

    <SolidColorBrush x:Key="WarningSoftBgBrush" Color="#291E0C"/>
    <SolidColorBrush x:Key="WarningSoftBorderBrush" Color="#92400E"/>
    <SolidColorBrush x:Key="WarningSoftTextBrush" Color="#FCD34D"/>

    <SolidColorBrush x:Key="InfoSoftBgBrush" Color="#102038"/>
    <SolidColorBrush x:Key="InfoSoftBorderBrush" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="InfoSoftTextBrush" Color="#93C5FD"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="FavoriteBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2C3649"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#43526D"/>
</ResourceDictionary>

# Copy to .env on your Oracle Cloud Ampere A1 VM (NEVER commit .env to Git)
API_DOMAIN=api.switchly.id

# Strong random password for PostgreSQL 16
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Generate with: docker compose run --rm api --generate-keys
LICENSE_ED25519_PRIVATE_KEY=CHANGE_ME_32_BYTE_BASE64_SEED
LICENSE_TOKEN_HASH_PEPPER=CHANGE_ME_RANDOM_HEX_PEPPER

# Midtrans Snap (set MIDTRANS_IS_PRODUCTION=true when going live)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-CHANGE_ME
MIDTRANS_CLIENT_KEY=SB-Mid-client-CHANGE_ME
MIDTRANS_FINISH_REDIRECT_URL=https://switchly.id/pembayaran-selesai

# Email OTP via Resend HTTPS API (OCI blocks SMTP port 25)
# Use EMAIL_PROVIDER=Console for local testing without sending real emails
EMAIL_PROVIDER=Resend
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM_ADDRESS=Switchly <noreply@switchly.id>
